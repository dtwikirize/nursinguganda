Options -MultiViews
RewriteEngine On

ErrorDocument 404 /_offline.html
ErrorDocument 503 /_offline.html

# Never rewrite Hostinger PHP API endpoints
RewriteRule ^api/ - [L]

# Guard: if index.html is missing mid-deploy, serve offline page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/index.html !-f
RewriteRule ^ /_offline.html [L]

# Serve pre-rendered SEO HTML to search & AdSense crawlers when static folder exists
RewriteCond %{HTTP_USER_AGENT} (googlebot|adsbot-google|mediapartners-google|bingbot|slurp|duckduckbot|facebookexternalhit|twitterbot|whatsapp) [NC]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ %{REQUEST_URI}/index.html [L]

# Force React SPA for interactive application routes for human browsers
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^(courses|course|learn|ebooks|mock-exams|dictionary|instruments|clinical-tools|cart|checkout|login|my-learning|about|brand-kit|editorial-policy|privacy-policy|terms|contact)(\/.*)?$ /index.html [L,QSA]

# Serve existing real static files & directories (assets, sitemap.xml, robots.txt, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback all unmatched paths to React SPA index.html
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^ /index.html [L,QSA]

# GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# Browser Caching & Security Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
