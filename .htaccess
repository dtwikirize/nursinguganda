Options -MultiViews
RewriteEngine On

ErrorDocument 404 /404.html
ErrorDocument 503 /_offline.html

# Never rewrite Node/PHP API or MCP endpoints
RewriteRule ^(api|mcp)(/|$) - [L]

# Guard: if index.html is missing mid-deploy, serve offline page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/index.html !-f
RewriteRule ^ /_offline.html [L]

# Serve explicit agent discovery files directly
RewriteRule ^(robots\.txt|llms\.txt|sitemap\.xml|\.well-known/mcp/server-card\.json)$ - [L]

# Serve pre-rendered SEO HTML to search & AdSense crawlers when static folder exists
RewriteCond %{HTTP_USER_AGENT} (googlebot|adsbot-google|mediapartners-google|bingbot|slurp|duckduckbot|facebookexternalhit|twitterbot|whatsapp) [NC]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ %{REQUEST_URI}/index.html [L]

# Serve existing real static files & directories (assets, sitemap.xml, robots.txt, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicitly rewrite known interactive SPA routes to index.html (avoid swallowing genuine 404s)
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^$ /index.html [L,QSA]
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^(courses|course|learn|topics|ebooks|quizzes|mock-exams|dictionary|instruments|clinical-tools|templates|global-nursing|nursing-uk|nursing-usa|nursing-canada|nursing-australia|cart|checkout|login|my-learning|nodadmin|about|editorial-policy|privacy-policy|terms|contact)(\/.*)?$ /index.html [L,QSA]

# Return real 404 for unknown paths or missing files
RewriteRule ^ - [R=404,L]

# GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# Browser Caching & Security Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(service-worker|sw)\.js$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(json|txt|md)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
