ble":true,"href":"https:\/\/midwivesrevisionuganda.com\/wp-json\/wp\/v2\/media\/5157"}],"wp:attachment":[{"href":"https:\/\/midwivesrevisionuganda.com\/wp-json\/wp\/v2\/media?parent=5156"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/midwivesrevisionuganda.com\/wp-json\/wp\/v2\/categories?post=5156"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/midwivesrevisionuganda.com\/wp-json\/wp\/v2\/tags?post=5156"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}