 data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-0d7a5b6 elementor-widget elementor-widget-html\" data-id=\"0d7a5b6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n\/* --- Styling for the IMCI Instructions Page --- *\/\r\n\r\n\/* Define similar colors as the search tool for consistency *\/\r\n.imci-instructions-widget-wrapper :root {\r\n    \/* Define color variables for easier changes - scope them slightly *\/\r\n    --imci-primary-blue: #4a90e2; \/* Brighter blue *\/\r\n    --imci-primary-purple: #9013fe; \/* Vibrant purple *\/\r\n    --imci-gradient-start: #6e45e2; \/* Purpleish *\/\r\n    --imci-gradient-end: #88d3ce; \/* Tealish blue *\/\r\n    --imci-text-dark: #333;\r\n    --imci-text-medium: #555;\r\n    --imci-text-light: #f8f9fa;\r\n    --imci-warning-bg: #fff3cd;\r\n    --imci-warning-text: #856404;\r\n    --imci-warning-border: #ffeeba;\r\n}\r\n\r\n\/* Main Container Styling - Target specifically inside the widget *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container {\r\n    padding: 30px 25px;\r\n    background: linear-gradient(145deg, #f8faff 0%, #eef4ff 100%); \/* Light subtle gradient *\/\r\n    border-radius: 12px;\r\n    box-shadow: 0 6px 20px rgba(100, 100, 150, 0.1);\r\n    margin: 20px 0; \/* Add some space top\/bottom *\/\r\n    color: var(--imci-text-dark, #333); \/* Fallback color *\/\r\n    font-family: sans-serif; \/* Or inherit from theme *\/\r\n    line-height: 1.7;\r\n}\r\n\r\n\/* Headings *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container h2 {\r\n    text-align: center;\r\n    color: var(--imci-gradient-start, #6e45e2);\r\n    margin-top: 0;\r\n    margin-bottom: 25px;\r\n    font-size: 2em;\r\n    font-weight: 700;\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container h3 {\r\n    color: var(--imci-primary-blue, #4a90e2);\r\n    margin-top: 30px;\r\n    margin-bottom: 15px;\r\n    padding-bottom: 8px;\r\n    border-bottom: 1px solid rgba(74, 144, 226, 0.2);\r\n    font-size: 1.5em;\r\n}\r\n\r\n\/* Intro Text *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container .intro-text {\r\n    font-size: 1.1em;\r\n    color: var(--imci-text-medium, #555);\r\n    text-align: center;\r\n    margin-bottom: 25px;\r\n    padding: 0 10%; \/* Center text a bit *\/\r\n}\r\n\r\n\/* Separator *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container hr.separator {\r\n    border: 0;\r\n    border-top: 1px dashed #ddd;\r\n    margin: 35px 0;\r\n}\r\n\r\n\/* Instruction Steps List *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container .instruction-steps {\r\n    list-style: none;\r\n    padding-left: 0;\r\n    margin-top: 20px;\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .instruction-steps li {\r\n    display: flex;\r\n    align-items: flex-start; \/* Align icon top *\/\r\n    margin-bottom: 20px;\r\n    font-size: 1.05em;\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .instruction-steps i {\r\n    font-size: 1.6em; \/* Icon size *\/\r\n    color: var(--imci-primary-purple, #9013fe); \/* Icon color *\/\r\n    margin-right: 15px;\r\n    margin-top: 2px; \/* Align icon slightly *\/\r\n    width: 30px; \/* Fixed width for alignment *\/\r\n    text-align: center;\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .instruction-steps span {\r\n    flex: 1; \/* Take remaining space *\/\r\n}\r\n.imci-instructions-widget-wrapper .imci-instructions-container .instruction-steps strong {\r\n    color: var(--imci-text-dark, #333);\r\n}\r\n\r\n\/* Results Explanation List *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container .results-explanation {\r\n     list-style: none;\r\n     padding-left: 0;\r\n     margin-top: 15px;\r\n}\r\n.imci-instructions-widget-wrapper .imci-instructions-container .results-explanation li {\r\n    margin-bottom: 10px;\r\n    padding-left: 30px; \/* Space for icon *\/\r\n    position: relative;\r\n}\r\n.imci-instructions-widget-wrapper .imci-instructions-container .results-explanation i {\r\n     position: absolute;\r\n     left: 0;\r\n     top: 3px; \/* Align icon *\/\r\n     color: var(--imci-primary-blue, #4a90e2);\r\n     font-size: 1.2em;\r\n     width: 20px;\r\n     text-align: center;\r\n}\r\n\r\n\r\n\/* Disclaimer Box Styling *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container .disclaimer-box {\r\n    margin-top: 30px;\r\n    padding: 20px 25px;\r\n    background-color: var(--imci-warning-bg, #fff3cd);\r\n    color: var(--imci-warning-text, #856404);\r\n    border: 1px solid var(--imci-warning-border, #ffeeba);\r\n    border-left: 5px solid var(--imci-primary-purple, #9013fe); \/* Accent border *\/\r\n    border-radius: 8px;\r\n    position: relative; \/* For icon positioning *\/\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .disclaimer-box h3 {\r\n    color: var(--imci-primary-purple, #9013fe); \/* Match accent border *\/\r\n    margin-top: 0;\r\n    margin-bottom: 10px;\r\n    border-bottom: none; \/* Remove border from h3 inside disclaimer *\/\r\n    font-size: 1.3em;\r\n    padding-left: 30px; \/* Space for icon *\/\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .disclaimer-box i.fa-exclamation-triangle {\r\n     position: absolute;\r\n     left: 20px;\r\n     top: 25px;\r\n     font-size: 1.5em;\r\n     color: var(--imci-primary-purple, #9013fe);\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .disclaimer-box p {\r\n    margin-bottom: 0;\r\n    font-size: 0.95em;\r\n    line-height: 1.6;\r\n}\r\n\r\n\/* Call to Action Button Section *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container .cta-section {\r\n    text-align: center;\r\n    margin-top: 40px;\r\n    padding-top: 20px;\r\n    border-top: 1px solid #eee;\r\n}\r\n.imci-instructions-widget-wrapper .imci-instructions-container .cta-section p {\r\n    margin-bottom: 15px;\r\n    font-size: 1.1em;\r\n    color: var(--imci-text-medium, #555);\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .cta-button {\r\n    display: inline-block;\r\n    padding: 12px 30px;\r\n    font-size: 1rem;\r\n    font-weight: bold;\r\n    cursor: pointer;\r\n    border: none;\r\n    text-decoration: none;\r\n    \/* Match search button gradient *\/\r\n    background: linear-gradient(45deg, var(--imci-primary-purple, #9013fe), var(--imci-primary-blue, #4a90e2));\r\n    color: var(--imci-text-light, #f8f9fa) !important; \/* Ensure light text color *\/\r\n    border-radius: 50px; \/* Pill shape *\/\r\n    transition: all 0.3s ease;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\r\n}\r\n\r\n.imci-instructions-widget-wrapper .imci-instructions-container .cta-button:hover,\r\n.imci-instructions-widget-wrapper .imci-instructions-container .cta-button:focus {\r\n    background: linear-gradient(45deg, var(--imci-primary-blue, #4a90e2), var(--imci-primary-purple, #9013fe));\r\n    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);\r\n    transform: translateY(-2px);\r\n    color: var(--imci-text-light, #f8f9fa) !important; \/* Ensure light text color *\/\r\n}\r\n\r\n\/* Adjust link color within text *\/\r\n.imci-instructions-widget-wrapper .imci-instructions-container a:not(.cta-button) { \/* Exclude CTA button *\/\r\n    color: var(--imci-primary-blue, #4a90e2);\r\n    text-decoration: underline;\r\n}\r\n.imci-instructions-widget-wrapper .imci-instructions-container a:not(.cta-button):hover {\r\n    color: var(--imci-primary-purple, #9013fe);\r\n}\r\n\r\n<\/style>\r\n\r\n<!-- Added a wrapper div to help scope the CSS -->\r\n<div class=\"imci-instructions-widget-wrapper\">\r\n    <div class=\"imci-instructions-container\">\r\n\r\n        <h2>How to Use the IMCI Handbook Search Tool<\/h2>\r\n\r\n        <p class=\"intro-text\">\r\n            Welcome! This tool provides quick access to information based on the Integrated Management of Childhood Illness (IMCI) guidelines used in Uganda. It's designed to assist health workers in assessing, classifying, and identifying treatments for common childhood conditions.\r\n        <\/p>\r\n\r\n        <hr class=\"separator\">\r\n\r\n        <h3>Searching for Information<\/h3>\r\n\r\n        <ul class=\"instruction-steps\">\r\n            <li>\r\n                <i class=\"fas fa-keyboard\"><\/i> <!-- Font Awesome Icon -->\r\n                <span>\r\n                    <strong>Type Your Query:<\/strong> In the search box provided on the <a href=\"\/imci-handbook-search\/\">Search Tool Page<\/a>, simply type a symptom (e.g., \"fever\", \"cough\", \"diarrhoea\"), a condition name (e.g., \"pneumonia\", \"malaria\", \"dysentery\"), or a related keyword (e.g., \"danger sign\", \"dehydration\", \"zinc\").\r\n                <\/span>\r\n            <\/li>\r\n            <li>\r\n                <i class=\"fas fa-lightbulb\"><\/i> <!-- Font Awesome Icon -->\r\n                <span>\r\n                    <strong>Use Suggestions:<\/strong> As you type (after 2 characters), a list of possible conditions and keywords may appear below the search box. You can click on a suggestion to search for it directly.\r\n                 <\/span>\r\n            <\/li>\r\n            <li>\r\n                 <i class=\"fas fa-search\"><\/i> <!-- Font Awesome Icon -->\r\n                 <span>\r\n                    <strong>Click Search:<\/strong> Once you've entered your term, click the \"Search\" button.\r\n                 <\/span>\r\n            <\/li>\r\n        <\/ul>\r\n\r\n        <h3>Understanding the Results<\/h3>\r\n\r\n        <p>\r\n            If matches are found, the tool will display information cards for each relevant condition. Each card typically includes:\r\n        <\/p>\r\n        <ul class=\"results-explanation\">\r\n             <li><i class=\"fas fa-stethoscope\"><\/i> <strong>Assessment:<\/strong> Key questions to ask and signs to look for.<\/li>\r\n             <li><i class=\"fas fa-tags\"><\/i> <strong>Classification:<\/strong> How to categorize the severity based on the assessment findings.<\/li>\r\n             <li><i class=\"fas fa-pills\"><\/i> <strong>Treatment & Counselling:<\/strong> Recommended treatments, medications, and advice for the caregiver, including relevant counselling points.<\/li>\r\n             <li><i class=\"fas fa-image\"><\/i> <strong>Images:<\/strong> Where relevant, an image related to the condition might be displayed.<\/li>\r\n        <\/ul>\r\n         <p>\r\n            Advertisements may occasionally appear between the result cards.\r\n        <\/p>\r\n\r\n\r\n        <hr class=\"separator\">\r\n\r\n        <div class=\"disclaimer-box\">\r\n            <i class=\"fas fa-exclamation-triangle\"><\/i> <!-- Font Awesome Icon -->\r\n            <h3>Important Disclaimer<\/h3>\r\n            <p>\r\n                This search tool is intended for informational and educational purposes for trained health workers familiar with IMCI protocols. **It is NOT a substitute for professional medical advice, diagnosis, or treatment.** Parents and caregivers concerned about a child's health should ALWAYS consult a qualified healthcare provider immediately. Do not delay seeking professional medical help based on information found here. The creators of this tool are not liable for any decisions made based on its content.\r\n            <\/p>\r\n        <\/div>\r\n\r\n        <div class=\"cta-section\">\r\n            <p>Ready to find information?<\/p>\r\n            <a href=\"\/imci-handbook-search\/\" class=\"cta-button\">Go to the Search Tool<\/a>\r\n            <!-- Make sure the link above points to your actual search page URL -->\r\n        <\/div>\r\n\r\n    <\/div><!-- end .imci-instructions-container -->\r\n<\/div><!-- end .imci-instructions-widget-wrapper -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-20de920 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"20de920\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;_ha_eqh_enable&quot;:false}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-8a857d3\" data-id=\"8a857d3\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-d262333 elementor-widget elementor-widget-html\" data-id=\"d262333\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<script async src=\"https:\/\/pagead2.googlesyndication.com\/pagead\/js\/adsbygoogle.js?client=ca-pub-5767364969818632\"\r\n     crossorigin=\"anonymous\"><\/script>\r\n<ins class=\"adsbygoogle\"\r\n     style=\"display:block\"\r\n     data-ad-format=\"autorelaxed\"\r\n     data-ad-client=\"ca-pub-5767364969818632\"\r\n     data-ad-slot=\"1271890507\"><\/ins>\r\n<script>\r\n     (adsbygoogle = window.adsbygoogle || []).push({});\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-901f08f elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"901f08f\" data-element_type=\"section\" data-e-type=\"section\" da