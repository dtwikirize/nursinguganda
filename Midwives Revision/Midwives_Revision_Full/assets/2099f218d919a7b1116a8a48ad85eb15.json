    --imci-home-text-medium: #5a6072;\r\n    --imci-home-text-light: #ffffff;\r\n    --imci-home-border: #e8eaf6;\r\n    --imci-home-shadow: rgba(127, 90, 240, 0.08);\r\n    --imci-home-shadow-hover: rgba(127, 90, 240, 0.15);\r\n\r\n    padding: 10px 0;\r\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\r\n    color: var(--imci-home-text-dark);\r\n    box-sizing: border-box;\r\n}\r\n.imci-styled-homepage-wrapper *,\r\n.imci-styled-homepage-wrapper *::before,\r\n.imci-styled-homepage-wrapper *::after {\r\n    box-sizing: inherit;\r\n}\r\n\r\n\/* Overall Hero Background Container *\/\r\n.imci-styled-homepage-wrapper .imci-hero-background {\r\n    background: linear-gradient(110deg, var(--imci-home-primary, #7f5af0) 10%, var(--imci-home-secondary, #2cb67d) 90%);\r\n    border-radius: 18px;\r\n    padding: 40px 15px 50px 15px; \/* Adjusted horizontal padding *\/\r\n    margin-bottom: 0;\r\n    box-shadow: 0 10px 25px var(--imci-home-shadow);\r\n    max-width: 1140px;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n}\r\n\r\n\/* Hero Title\/Subtitle Area *\/\r\n.imci-styled-homepage-wrapper .imci-hero-content { text-align: center; max-width: 750px; margin: 0 auto 35px auto; }\r\n.imci-styled-homepage-wrapper .imci-hero-content h1 { font-size: 2.5em; font-weight: 700; color: var(--imci-home-text-light); margin-top: 0; margin-bottom: 15px; text-shadow: 1px 1px 3px rgba(0,0,0,0.1); }\r\n.imci-styled-homepage-wrapper .imci-hero-content .subtitle { font-size: 1.1em; color: rgba(255, 255, 255, 0.9); margin-bottom: 0; line-height: 1.6; }\r\n\r\n\/* Wrapper for the Search Form Container *\/\r\n.imci-styled-homepage-wrapper .imci-search-form-container {\r\n    max-width: 800px; margin: 0 auto; background: rgba(255,255,255, 0.15); padding: 25px 30px; border-radius: 16px; backdrop-filter: blur(8px) saturate(120%); -webkit-backdrop-filter: blur(8px) saturate(120%); border: 1px solid rgba(255, 255, 255, 0.2); box-shadow: 0 6px 20px rgba(0,0,0,0.1);\r\n}\r\n\/* Reset plugin's container styles when nested *\/\r\n.imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-search-container-v3 { padding: 0; margin-bottom: 0; background: none; box-shadow: none; }\r\n.imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-search-form-v3 { margin-bottom: 15px; }\r\n.imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-suggestion-buttons { margin-top: 10px; }\r\n.imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-suggestion-buttons span { color: rgba(255, 255, 255, 0.8); }\r\n.imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-suggestion-buttons a { background: rgba(255, 255, 255, 0.2); color: var(--imci-home-text-light); border: none; }\r\n.imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-suggestion-buttons a:hover { background: rgba(255, 255, 255, 0.4); }\r\n\r\n\/* Features Section *\/\r\n.imci-styled-homepage-wrapper .imci-home-features { margin-bottom: 50px; padding: 0 10px; }\r\n.imci-styled-homepage-wrapper .imci-home-features h2,\r\n.imci-styled-homepage-wrapper .imci-home-common h2 { text-align: center; font-size: 1.8em; font-weight: 600; color: var(--imci-home-text-dark); margin-bottom: 40px; padding: 0 15px; }\r\n.imci-styled-homepage-wrapper .imci-features-grid { display: grid; gap: 25px; padding: 0 15px; grid-template-columns: 1fr; }\r\n.imci-styled-homepage-wrapper .imci-feature-card { background-color: var(--imci-home-bg-subtle, #ffffff); padding: 25px; border-radius: 12px; border: 1px solid var(--imci-home-border, #e8eaf6); box-shadow: 0 5px 15px var(--imci-home-shadow, rgba(127, 90, 240, 0.08)); transition: transform 0.3s ease, box-shadow 0.3s ease; display: flex; flex-direction: column; text-align: center; }\r\n.imci-styled-homepage-wrapper .imci-feature-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px var(--imci-home-shadow-hover, rgba(127, 90, 240, 0.15)); }\r\n.imci-styled-homepage-wrapper .imci-feature-card .icon-wrapper { display: inline-flex; justify-content: center; align-items: center; width: 60px; height: 60px; background: linear-gradient(135deg, var(--imci-home-primary, #7f5af0), var(--imci-home-secondary, #2cb67d)); border-radius: 50%; margin: 0 auto 20px auto; }\r\n.imci-styled-homepage-wrapper .imci-feature-card i { color: var(--imci-home-text-light, #ffffff); font-size: 1.8em; }\r\n.imci-styled-homepage-wrapper .imci-feature-card h3 { font-size: 1.2em; font-weight: 600; color: var(--imci-home-primary, #7f5af0); margin-bottom: 10px; }\r\n.imci-styled-homepage-wrapper .imci-feature-card p { font-size: 0.95em; color: var(--imci-home-text-medium, #5a6072); line-height: 1.6; margin-bottom: 0; }\r\n\r\n\/* Common Conditions Section *\/\r\n.imci-styled-homepage-wrapper .imci-home-common { margin-bottom: 50px; padding: 0 10px; }\r\n.imci-styled-homepage-wrapper .imci-common-grid { display: grid; gap: 25px; padding: 0 15px; grid-template-columns: 1fr; }\r\n.imci-styled-homepage-wrapper .imci-common-card { background-color: var(--imci-home-bg-subtle, #ffffff); padding: 25px; border-radius: 12px; border: 1px solid var(--imci-home-border, #e8eaf6); box-shadow: 0 5px 15px var(--imci-home-shadow, rgba(127, 90, 240, 0.08)); display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.3s ease, box-shadow 0.3s ease; }\r\n.imci-styled-homepage-wrapper .imci-common-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px var(--imci-home-shadow-hover, rgba(127, 90, 240, 0.15)); }\r\n.imci-styled-homepage-wrapper .imci-common-card .category { font-size: 0.8em; color: var(--imci-home-text-medium, #5a6072); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }\r\n.imci-styled-homepage-wrapper .imci-common-card h3 { font-size: 1.3em; font-weight: 600; color: var(--imci-home-text-dark, #2b2c34); margin-top: 0; margin-bottom: 10px; }\r\n.imci-styled-homepage-wrapper .imci-common-card p { font-size: 0.95em; color: var(--imci-home-text-medium, #5a6072); line-height: 1.6; margin-bottom: 20px; flex-grow: 1; }\r\n.imci-styled-homepage-wrapper .imci-details-link { display: inline-flex; align-items: center; text-decoration: none; color: var(--imci-home-primary, #7f5af0); font-weight: 600; font-size: 0.95em; transition: color 0.3s ease; align-self: flex-start; }\r\n.imci-styled-homepage-wrapper .imci-details-link:hover { color: var(--imci-home-secondary, #2cb67d); }\r\n.imci-styled-homepage-wrapper .imci-details-link i { margin-left: 8px; transition: transform 0.3s ease; }\r\n.imci-styled-homepage-wrapper .imci-details-link:hover i { transform: translateX(3px); }\r\n\r\n\/* Responsive Grid Adjustments *\/\r\n@media (min-width: 600px) {\r\n    .imci-styled-homepage-wrapper .imci-features-grid,\r\n    .imci-styled-homepage-wrapper .imci-common-grid { grid-template-columns: repeat(2, 1fr); }\r\n}\r\n@media (min-width: 992px) {\r\n    .imci-styled-homepage-wrapper .imci-features-grid,\r\n    .imci-styled-homepage-wrapper .imci-common-grid { grid-template-columns: repeat(4, 1fr); }\r\n    .imci-styled-homepage-wrapper .imci-hero-background { padding: 70px 50px 80px 50px; }\r\n     .imci-styled-homepage-wrapper .imci-hero-content h1 { font-size: 2.8em; }\r\n     .imci-styled-homepage-wrapper .imci-hero-content .subtitle { font-size: 1.15em; }\r\n}\r\n\r\n\/* --- MOBILE FIX for Search Form Container Padding --- *\/\r\n@media (max-width: 600px) { \/* Target smaller tablets and phones *\/\r\n    .imci-styled-homepage-wrapper .imci-hero-background {\r\n        padding-left: 15px; \/* Reduce padding *\/\r\n        padding-right: 15px;\r\n    }\r\n    .imci-styled-homepage-wrapper .imci-search-form-container {\r\n        padding: 20px 15px; \/* Reduce padding significantly *\/\r\n    }\r\n    \/* Make suggestion buttons slightly smaller *\/\r\n    .imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-suggestion-buttons a {\r\n        padding: 4px 10px;\r\n        font-size: 0.8rem;\r\n    }\r\n    \/* Ensure form elements stack nicely *\/\r\n    .imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-search-form-v3 {\r\n         flex-direction: column;\r\n         align-items: stretch;\r\n    }\r\n     .imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-filter-group select {\r\n         width: 100%; \/* Full width dropdown *\/\r\n     }\r\n     .imci-styled-homepage-wrapper .imci-search-form-container .imci-plugin-content-wrapper .imci-search-input-group-v3 {\r\n         max-width: none; \/* Allow full width *\/\r\n         width: 100%;\r\n     }\r\n}\r\n\r\n<\/style>\r\n\r\n<!-- Wrapper div to help scope CSS within the widget -->\r\n<div class=\"imci-styled-homepage-wrapper\">\r\n\r\n    <!-- 1. Hero Background Container -->\r\n    <section class=\"imci-hero-background\">\r\n        <!-- Hero Title\/Subtitle -->\r\n        <div class=\"imci-hero-content\">\r\n            <h1>IMCI Handbook Search Tool<\/h1>\r\n            <p class=\"subtitle\">\r\n                A quick reference tool based on the Uganda IMCI guidelines for healthcare workers. Easily search for conditions, assessments, classifications, and treatments.\r\n            <\/p>\r\n        <\/div>\r\n        <!-- Container for the Search Form (Plugin Shortcode Goes Here) -->\r\n        <div class=\"imci-search-form-container\">\r\n            <!-- The actual search form will be generated here by the shortcode -->\r\n                <div class=\"imci-plugin-content-wrapper\">\r\n\r\n        <!-- SECTION 1: Search Area -->\r\n        <div class=\"imci-search-area-wrapper\">\r\n            <div class=\"imci-search-container-v3\"> <!-- New class for search container -->\r\n                 <form method=\"get\" action=\"https:\/\/midwivesrevisionuganda.com\/imci-handbook-search\/\" class=\"imci-search-form-v3\"> <!-- New class -->\r\n                                          <div class=\"imci-filter-group\">\r\n                         <label for=\"imci_age_group_select\" class=\"screen-reader-text\">Filter by Age Group:<\/label>\r\n                         <select name=\"imci_age_group\" id=\"imci_age_group_select\">\r\n                             <option value=\"all\"  selected='selected'>All Age Groups<\/option>\r\n                             <option value=\"0 - 2 months\" >0 - 2 Months<\/option>\r\n                             <option value=\"2 months - 5 years\" >2 Months - 5 Years<\/option>\r\n                         <\/select>\r\n                     <\/div>\r\n                     <div class=\"imci-search-input-group-v3\"> <!-- New class -->\r\n                        <label for=\"imci_query_input\" class=\"screen-reader-text\">Search Conditions:<\/label>\r\n                        <input id=\"imci_query_input\" type=\"text\" name=\"imci_query\" autocomplete=\"off\" placeholder=\"Search conditions, symptoms...\" value=\"\" >\r\n                        <button type=\"submit\" class=\"imci-search-button-v3\"><i class=\"fas fa-search\"><\/i><span class=\"search-button-text\">Search<\/span><\/button> <!-- New class -->\r\n                     <\/div>\r\n                <\/form>\r\n                <div class=\"imci-suggestion-buttons\">\r\n                     <span>Common:<\/span>\r\n                     <a href=\"?imci_query=Malaria\">Malaria<\/a>\r\n                     <a href=\"?imci_query=Pneumonia\">Pneumonia<\/a>\r\n                     <a href=\"?imci_query=Diarrhoea\">Diarrhoea<\/a>\r\n                     <a href=\"?imci_query=Fever\">Fever<\/a>\r\n                     <a href=\"?imci_query=HIV\">HIV<\/a>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div><!-- end .imci-search-area-wrapper -->\r\n\r\n\r\n        <!-- SECTION 2: Results Area -->\r\n        \r\n    <\/div> <!-- End imci-plugin-content-wrapper -->\r\n    \r\n            <!-- NOTE: The shortcode now only needs to output the form + suggestions -->\r\n            <!-- The outer gradient and title are handled by the sections above -->\r\n        <\/div>\r\n    <\/section>\r\n\r\n    <!-- 2. Features Section -->\r\n    <section class=\"imci-home-features\">\r\n        <h2>Features<\/h2>\r\n        <div class=\"imci-features-grid\">\r\n            <div class=\"imci-feature-card\">\r\n                <div class=\"icon-wrapper\"><i class=\"fas fa-book-medical\"><\/i><\/div>\r\n                <h3>IMCI Guidelines<\/h3>\r\n                <p>Quickly access assessment, classification, and treatment protocols from the guidelines.<\/p>\r\n            <\/div>\r\n            <div class=\"imci-feature-card\">\r\n                <div class=\"icon-wrapper\"><i class=\"fas fa-search\"><\/i><\/div>\r\n                <h3>Symptom Search<\/h3>\r\n                <p>Search by condition name, keyword, or common symptoms like 'fever' or 'cough'.<\/p>\r\n            <\/div>\r\n             <div class=\"imci-feature-card\">\r\n                <div class=\"icon-wrapper\"><i class=\"fas fa-baby\"><\/i><\/div>\r\n                <h3>Age Groups<\/h3>\r\n                <p>Filter information specifically for Young Infants (0-2 months) or Children (2 months - 5 years).<\/p>\r\n            <\/div>\r\n            <div class=\"imci-feature-card\">\r\n                <div class=\"icon-wrapper\"><i class=\"fas fa-exclamation-triangle\"><\/i><\/div>\r\n                <h3>Red Flags<\/h3>\r\n                <p>Easily identify critical warning signs requiring urgent action or referral.<\/p>\r\n            <\/div>\r\n        <\/div>\r\n    <\/section>\r\n\r\n    <!-- 3. Common Conditions Section (Links using search query) -->\r\n    <section class=\"imci-home-common\">\r\n        <h2>Common Conditions Quick Access<\/h2>\r\n        <div class=\"imci-common-grid\">\r\n            <div class=\"imci-common-card\">\r\n                <span class=\"category\">Respiratory<\/span>\r\n                <h3>Cough \/ Pneumonia<\/h3>\r\n                <p>Guidelines for assessing cough, difficult breathing, and classifying pneumonia severity.<\/p>\r\n                <a href=\"?imci_query=Pneumonia\" class=\"imci-details-link\">Search Now <i class=\"fas fa-arrow-right\"><\/i><\/a>\r\n            <\/div>\r\n            <div class=\"imci-common-card\">\r\n                <span class=\"category\">Gastrointestinal<\/span>\r\n                <h3>Diarrhoea \/ Dehydration<\/h3>\r\n                <p>Protocols for managing diarrhoea, assessing dehydration levels, and fluid management.<\/p>\r\n                 <a href=\"?imci_query=Diarrhoea\" class=\"imci-details-link\">Search Now <i class=\"fas fa-arrow-right\"><\/i><\/a>\r\n            <\/div>\r\n             <div class=\"imci-common-card\">\r\n                <span class=\"category\">Systemic<\/span>\r\n                <h3>Fever \/ Malaria<\/h3>\r\n                <p>Steps for managing fever, malaria testing, and treating febrile illnesses.<\/p>\r\n                 <a href=\"?imci_query=Fever\" class=\"imci-details-link\">Search Now <i class=\"fas fa-arrow-right\"><\/i><\/a>\r\n            <\/div>\r\n             <div class=\"imci-common-card\">\r\n                <span class=\"category\">Severe Illness<\/span>\r\n                <h3>Danger Signs<\/h3>\r\n                <p>Identification of life-threatening general danger signs requiring urgent referral.<\/p>\r\n                 <a href=\"?imci_query=Danger+Sign\" class=\"imci-details-link\">Search Now <i class=\"fas fa-arrow-right\"><\/i><\/a>\r\n            <\/div>\r\n        <\/div>\r\n    <\/section>\r\n\r\n<\/div><!-- end .imci-styled-homepage-wrapper -->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elemen