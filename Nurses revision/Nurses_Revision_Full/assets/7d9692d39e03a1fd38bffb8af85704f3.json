kground-repeat":"repeat","background-position":"center center","background-size":"auto","background-attachment":"scroll","background-type":"","background-media":"","overlay-type":"","overlay-color":"","overlay-opacity":"","overlay-gradient":""}},"footnotes":""},"categories":[601],"tags":[],"class_list":["post-23683","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-uncategorised"],"acf":[],"_links":{"self":[{"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/posts\/23683","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/users\/31"}],"replies":[{"embeddable":true,"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/comments?post=23683"}],"version-history":[{"count":0,"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/posts\/23683\/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/media\/23588"}],"wp:attachment":[{"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/media?parent=23683"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/categories?post=23683"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/nursesrevisionuganda.com\/wp-json\/wp\/v2\/tags?post=23683"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}