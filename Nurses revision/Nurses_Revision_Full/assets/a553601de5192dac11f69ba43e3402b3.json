\n            --white: #ffffff;\r\n        }\r\n\r\n        * { box-sizing: border-box; margin: 0; padding: 0; }\r\n        body { \r\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; \r\n            background-color: #fdfbff;\r\n            color: var(--text-main);\r\n            line-height: 1.6;\r\n            overflow-x: hidden;\r\n        }\r\n\r\n        \/* 2. FULL-WIDTH BREAKOUT HERO *\/\r\n        .hero {\r\n            width: 100vw;\r\n            position: relative;\r\n            left: 50%;\r\n            right: 50%;\r\n            margin-left: -50vw;\r\n            margin-right: -50vw;\r\n            padding: 80px 20px;\r\n            background: linear-gradient(135deg, rgba(59, 7, 100, 0.9) 0%, rgba(147, 51, 234, 0.8) 100%),\r\n                        url('https:\/\/nursesrevisionuganda.com\/wp-content\/uploads\/2022\/12\/nurses-in-an-examination-room.jpg');\r\n            background-size: cover;\r\n            background-position: center;\r\n            text-align: center;\r\n            color: var(--white);\r\n            border-bottom: 4px solid var(--brand-purple);\r\n        }\r\n\r\n        .hero h1 { font-size: 34px; font-weight: 900; margin-bottom: 10px; text-transform: uppercase; letter-spacing: -1px; }\r\n        .hero p { font-size: 16px; opacity: 0.8; font-weight: 500; }\r\n\r\n        \/* 3. CONTENT STRUCTURE *\/\r\n        .container {\r\n            max-width: 850px;\r\n            margin: 0 auto;\r\n            padding: 50px 20px 100px 20px;\r\n        }\r\n\r\n        \/* 4. DISCLAIMER CARDS *\/\r\n        .card {\r\n            background: var(--white);\r\n            padding: 30px;\r\n            border-radius: 24px;\r\n            border: 1px solid rgba(147, 51, 234, 0.1);\r\n            margin-bottom: 30px;\r\n            box-shadow: 0 4px 15px rgba(59, 7, 100, 0.03);\r\n        }\r\n\r\n        .card h2 {\r\n            font-size: 18px;\r\n            font-weight: 900;\r\n            color: var(--brand-deep);\r\n            margin-bottom: 15px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n\r\n        .card h2::before {\r\n            content: \"\";\r\n            width: 4px;\r\n            height: 18px;\r\n            background: var(--brand-purple);\r\n            border-radius: 10px;\r\n        }\r\n\r\n        .card p {\r\n            font-size: 15px;\r\n            color: var(--text-muted);\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        \/* 5. HIGH-IMPORTANCE WARNING BOX *\/\r\n        .warning-box {\r\n            background: #fff5f5;\r\n            border: 2px solid #feb2b2;\r\n            padding: 25px;\r\n            border-radius: 18px;\r\n            margin: 20px 0;\r\n        }\r\n        .warning-box b { color: var(--alert-red); display: block; margin-bottom: 10px; font-size: 16px; }\r\n        .warning-box p { color: #742a2a !important; font-weight: 500; margin-bottom: 0; }\r\n\r\n        \/* 6. TESTIMONIAL HIGHLIGHT *\/\r\n        .italic-box {\r\n            border-left: 3px italic var(--brand-purple);\r\n            padding-left: 20px;\r\n            font-style: italic;\r\n            color: var(--text-muted);\r\n        }\r\n\r\n        \/* 7. CONTACT CTA *\/\r\n        .contact-cta {\r\n            text-align: center;\r\n            padding: 40px;\r\n            background: var(--brand-light);\r\n            border-radius: 30px;\r\n            margin-top: 50px;\r\n        }\r\n        .contact-cta a { color: var(--brand-purple); font-weight: 800; text-decoration: none; }\r\n\r\n        @media (min-width: 768px) {\r\n            .hero h1 { font-size: 52px; }\r\n            .card { padding: 45px; }\r\n        }\r\n    <\/style>\r\n<\/head>\r\n<body>\r\n\r\n    <!-- HERO HEADER -->\r\n    <header class=\"hero\">\r\n        <h1>Disclaimer<\/h1>\r\n        <p>Legal Notice & Ter