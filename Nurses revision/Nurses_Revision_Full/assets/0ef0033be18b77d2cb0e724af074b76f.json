ta { flex-direction: column; align-items: center; gap: 10px; }\r\n    }\r\n<\/style>\r\n\r\n<div class=\"curriculum-page-wrapper\">\r\n    <!-- Hero Section -->\r\n    <div class=\"unit-hero\">\r\n        <span class=\"hero-badge\">PHY 1 & 2<\/span>\r\n        <h1>BNS 112: <span class=\"unit-highlight\"> Physiology Curriculum<\/span><\/h1>\r\n        <p>An in-depth look at the function of the human body, from cellular mechanisms to the integrated operations of major organ systems.<\/p>\r\n        \r\n        <div class=\"hero-meta\">\r\n            <span><i class=\"fas fa-medal\"><\/i> 8 Credit Units<\/span>\r\n            <span><i class=\"fas fa-layer-group\"><\/i> 3 Major Components<\/span>\r\n            <span><i class=\"fas fa-clock\"><\/i> Full Year Course<\/span>\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <!-- Course Content Section -->\r\n    <div class=\"unit-content-section\">\r\n        <h2>Course Units<\/h2>\r\n        <p>Explore the complete Physiology curriculum from Year I to Year II.<\/p>\r\n\r\n        <!-- Main Container -->\r\n        <div class=\"unit-container\">\r\n\r\n            <!-- YEAR 1 -->\r\n            <h3 class=\"year-divider\">YEAR I<\/h3>\r\n\r\n            <!-- Card 1: PHY 111 -->\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-purple\"><i class=\"fas fa-lungs\"><\/i><\/div>\r\n                    <div class=\"unit-card-header-text\">\r\n                        <span class=\"unit-badge badge-purple\">PHY 111<\/span>\r\n                        <h3>General Physiology, Blood and Respiratory Physiology<\/h3>\r\n                    <\/div>\r\n                <\/div>\r\n                \r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">General and Cellular Physiology<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Cell Function & Transport<\/a><\/li>\r\n                        <li><a href=\"#\">Homeostasis<\/a><\/li>\r\n                        <li><a href=\"#\">Body Fluids<\/a><\/li>\r\n                        <li><a href=\"#\">Excitability<\/a><\/li>\r\n                        <li><a href=\"#\">Nerve and Muscle Physiology<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n\r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Blood (Hematology)<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Blood Introduction<\/a><\/li>\r\n                        <li><a href=\"#\">Red Blood Cells<\/a><\/li>\r\n                        <li><a href=\"#\">White Blood Cells<\/a><\/li>\r\n                        <li><a href=\"#\">Hemostasis and Coagulation<\/a><\/li>\r\n                        <li><a href=\"#\">Blood Groups & Transfusion<\/a><\/li>\r\n                        <li><a href=\"#\">Blood Indices & Metabolism<\/a><\/li>\r\n                        <li><a href=\"#\">Related Pathophysiology<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n\r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Respiratory Physiology<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Mechanics of Breathing<\/a><\/li>\r\n                        <li><a href=\"#\">Gas Exchange, Transport & V\/Q<\/a><\/li>\r\n                        <li><a href=\"#\">Control of Respiration<\/a><\/li>\r\n                        <li><a href=\"#\">Respiratory Function Tests<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <!-- Card 2: PHY 122 -->\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-blue\"><i class=\"fas fa-heart-pulse\"><\/i><\/div>\r\n                    <div class=\"unit-card-header-text\">\r\n                        <span class=\"unit-badge badge-blue\">PHY 122<\/span>\r\n                        <h3>Cardiovascular, GIT and Renal Physiology<\/h3>\r\n                    <\/div>\r\n                <\/div>\r\n                \r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Cardiovascular Physiology<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Circulation & Hemodynamics<\/a><\/li>\r\n                        <li><a href=\"#\">The Heart & Cardiac Cycle<\/a><\/li>\r\n                        <li><a href=\"#\">Vasculature & Blood Pressure<\/a><\/li>\r\n                        <li><a href=\"#\">Systemic Regulation<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n\r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Gastrointestinal (GIT) Physiology<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">GIT Functions, Neuro & Motility<\/a><\/li>\r\n                        <li><a href=\"#\">Digestion, Absorption & GI Disorders<\/a><\/li>\r\n                        <li><a href=\"#\">GI Secretions<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n\r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Renal Physiology<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Functional, GFR, Haemodynamics & Diuretics<\/a><\/li>\r\n                        <li><a href=\"#\">Renal Clearance & Micturition<\/a><\/li>\r\n                        <li><a href=\"#\">Endocrine Role of Kidney<\/a><\/li>\r\n                        <li><a href=\"#\">Renal Function Assessment<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <!-- YEAR 2 -->\r\n            <h3 class=\"year-divider\">YEAR II<\/h3>\r\n\r\n            <!-- Card 3: PHY 231 -->\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-pink\"><i class=\"fas fa-venus-mars\"><\/i><\/div>\r\n                    <div class=\"unit-card-header-text\">\r\n                        <span class=\"unit-badge badge-pink\">PHY 231<\/span>\r\n                        <h3>Endocrine and Reproductive Physiology<\/h3>\r\n                    <\/div>\r\n                <\/div>\r\n                \r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">General Endocrinology<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Endocrine System Intro<\/a><\/li>\r\n                        <li><a href=\"#\">Hypothalamus & Pituitary Gland<\/a><\/li>\r\n                        <li><a href=\"#\">Hormone Regulation & Disorders<\/a><\/li>\r\n                        <li><a href=\"#\">Specific Endocrine Glands<\/a><\/li>\r\n                        <li><a href=\"#\">Transport, Clearance & Action of Hormone<\/a><\/li>\r\n                        <li><a href=\"#\">Thyroid Gland Physiology<\/a><\/li>\r\n                        <li><a href=\"#\">Parathyroid Gland Physiology<\/a><\/li>\r\n                        <li><a href=\"#\">Adrenal Gland Physiology<\/a><\/li>\r\n                        <li><a href=\"#\">Pancreas Physiology<\/a><\/li>\r\n                        <li><a href=\"#\">Growth Hormone Physiology<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n\r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Reproductive Physiology<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Male Reproductive System<\/a><\/li>\r\n                        <li><a href=\"#\">Female Reproductive System<\/a><\/li>\r\n                        <li><a href=\"#\">Pregnancy & Lactation<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <!-- Card 4: PHY 242 -->\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-green\"><i class=\"fas fa-brain\"><\/i><\/div>\r\n                    <div class=\"unit-card-header-text\">\r\n                        <span class=\"unit-badge badge-green\">PHY 242<\/span>\r\n                        <h3>Neurophysiology<\/h3>\r\n                    <\/div>\r\n                <\/div>\r\n                \r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Nervous System Functions<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Cellular Neurophysiology<\/a><\/li>\r\n                        <li><a href=\"#\">Sensory Systems<\/a><\/li>\r\n                        <li><a href=\"#\">Motor Systems<\/a><\/li>\r\n                        <li><a href=\"#\">Autonomic Nervous System<\/a><\/li>\r\n                        <li><a href=\"#\">Special Senses<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n\r\n                <div class=\"unit-sub-section\">\r\n                    <h4 class=\"unit-sub-heading\">Higher Brain Functions<\/h4>\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Temperature Regulation<\/a><\/li>\r\n                        <li><a href=\"#\">Limbic System & Emotion<\/a><\/li>\r\n                        <li><a href=\"#\">Learning and Memory<\/a><\/li>\r\n                        <li><a href=\"#\">Speech & EEG<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <!-- Key References Section -->\r\n    <div class=\"unit