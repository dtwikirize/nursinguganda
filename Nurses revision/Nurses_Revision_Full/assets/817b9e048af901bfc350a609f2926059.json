display: inline-flex; align-items: center; background: var(--hp-purple-main); color: white !important; padding: 12px 28px; border-radius: 50px; font-weight: 600; text-decoration: none; transition: 0.3s; }\r\n    .hp-btn-purple:hover { background: var(--hp-purple-dark); color: white;}\r\n\r\n    .hp-hero-features { display: flex; gap: 20px; margin-top: 30px; font-size: 0.9rem; color: var(--hp-text-gray); font-weight: 500; }\r\n    .hp-hero-features i { color: var(--hp-purple-main); margin-right: 5px; }\r\n\r\n    \/* Hero Image & Floating Cards *\/\r\n    .hp-hero-image-wrapper { position: relative; display: flex; justify-content: center; }\r\n    .hp-hero-image-wrapper img { width: 100%; max-width: 500px; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.1); }\r\n    .hp-floating-card { position: absolute; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); padding: 1px 20px; border-radius: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); display: flex; align-items: center; gap: 1px; border: 1px solid #f3f4f6; animation: float 6s ease-in-out infinite; }\r\n    .hp-floating-card.top-left { top: 20px; left: -30px; }\r\n    .hp-floating-card.bottom-right { bottom: 20px; right: -30px; animation-delay: 3s; }\r\n    .hp-icon-box { width: 40px; height: 40px; background: #f3e8ff; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--hp-purple-main); }\r\n    .hp-stat-title { font-size: 0.85rem; color: var(--hp-text-gray); margin: 0; font-weight: 600;}\r\n    .hp-stat-value { font-size: 0.95rem; font-weight: 700; margin: 0; }\r\n    .hp-text-green { color: #10b981; }\r\n\r\n    @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0px); } }\r\n\r\n    \/* Centered Call to Action Section *\/\r\n    .hp-cta-section { text-align: center; padding: 60px 20px; }\r\n    .hp-cta-section h2 { font-size: 2.5rem; margin-bottom: 15px; }\r\n    .hp-cta-section