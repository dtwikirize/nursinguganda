gin-top: 40px; }\r\n    \r\n    \r\n    \/* Testimonial Cards *\/\r\n    .hp-test-card { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }\r\n    .hp-quote-icon { color: var(--hp-purple-mid); font-size: 2rem; margin-bottom: 15px; }\r\n    .hp-test-text { font-size: 0.95rem; color: var(--hp-text-gray); font-style: italic; margin-bottom: 25px; }\r\n    .hp-test-author { display: flex; align-items: center; gap: 15px; }\r\n    .hp-avatar { width: 45px; height: 45px; background: var(--hp-purple-light); color: var(--hp-purple-dark); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.1rem; }\r\n    .hp-author-info h5 { margin: 0; font-size: 0.95rem; color: var(--hp-text-dark); }\r\n    .hp-author-info span { font-size: 0.8rem; color: var(--hp-text-gray); }\r\n\r\n    \/* Mobile Responsiveness *\/\r\n    @media (max-width: 900px) {\r\n        .hp-hero { grid-template-columns: 1fr; text-align: center; }\r\n        .hp-hero-desc { margin: 0 auto 30px auto; }\r\n        .hp-hero-features { justify-content: center; flex-wrap: wrap; }\r\n        .hp-floating-card.top-left { left: 10px; top: -10px; }\r\n        .hp-floating-card.bottom-right { right: 10px; bottom: -10px; }\r\n        .hp-hero-title { font-size: 2.8rem; }\r\n    }\r\n<\/style>\r\n\r\n<div class=\"hp-wrapper\">\r\n\r\n    <!-- Hero Section -->\r\n    <div class=\"hp-section hp-section-light-purple hp-hero\">\r\n        <div>\r\n            <div class=\"hp-hero-badge\">\r\n                <i class=\"fa-solid fa-graduation-cap\" style=\"margin-right: 8px;\"><\/i> Trusted by 10k + Medical Students\r\n            <\/div>\r\n            <h1 class=\"hp-hero-title\">Excel in Your <span class=\"hp-text-purple\">Medical Studies<\/span> with Africa's #1 Platform<\/h1>\r\n            <p class=\"hp-hero-desc\">Access comprehensive class notes, past papers, and exam resources designed following a medical curricula of Prestigious medical universities. Join thousands of successful medical students.<\/p>\r\n            \r\n            <a href=\"https:\/\/nursesrevisionuganda.com\/bachelor-of-nursing-science-curriculum\/\" class=\"hp-btn-gradient\">\r\n                Bachelors Nursing Science(BNS) <i class=\"fas fa-arrow-right\" style=\"margin-left: 10px;\"><\/i>\r\n            <\/a>\r\n\r\n            <div class=\"hp-hero-features\">\r\n                <span><i class=\"fas fa-check-circle\"><\/i> 100% Free Access<\/span>\r\n                <span><i class=\"fas fa-check-circle\"><\/i> Updated Content<\/span>\r\n                <span><i class=\"fas fa-check-circle\"><\/i> Study Buddy<\/span>\r\n            <\/div>\r\n        <\/div>\r\n\r\n        <div class=\"hp-hero-image-wrapper\">\r\n            <!-- Ensure you use your actual image URL here -->\r\n            <img decoding=\"async\" src=\"http:\/\/doctorsrevisionuganda.com\/wp-content\/uploads\/2025\/09\/doctor-revision.jpg\" alt=\"Medical Student\">\r\n            \r\n            <div class=\"hp-floating-card top-left\">\r\n                <div class=\"hp-icon-box\"><i class=\"fas fa-chart-line\"><\/i><\/div>\r\n                <div>\r\n                    <p class=\"hp-stat-title\">Pass Rates<\/p>\r\n                    <p class=\"hp-stat-value hp-text-green\">+95% vs last year<\/p>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <div class=\"hp-floating-card bottom-right\">\r\n                <div class=\"hp-icon-box\"><i class=\"fas fa-user-graduate\"><\/i><\/div>\r\n                <div>\r\n                    <p class=\"hp-stat-title\">Student Success<\/p>\r\n                    <p class=\"hp-stat-value\">10,000+ graduates<\/p>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <!-- Clinical Management Section -->\r\n    <div class=\"hp-cta-section\">\r\n        <h2>Master <span class=\"hp-text-purple\">Clinical Management<\/span> of Common Conditions<\/h2>\r\n        <p>Stay updated with the latest Uganda Clinical Guidelines (UCG). Quick access to evidence-based management protocols for the most common medical and surgical conditions.<\/p>\r\n        <a href=\"https:\/\/nursesrevisionuganda.com\/common-conditions-management-ucg\/#\/\" class=\"hp-btn-purple\" style=\"font-size: 1.1rem; padding: 15px 40px;\">\r\n            Common Condition Management <i class=\"fas fa-notes-medical\" style=\"margin-left: 10px;\"><\/i>\r\n        <\/a>\r\n    <\/div>\r\n\r\n    <!-- Search Section -->\r\n    <div class=\"hp-section hp-section-light-purple hp-text-center\">\r\n        <h2>Find Your Study Resources Instantly<\/h2>\r\n        <p style=\"color: var(--hp-text-gray);\">Search through thousands of medical notes, past papers, and study guides.<\/p>\r\n        \r\n        <form class=\"hp-search-box\" action=\"#\" method=\"GET\">\r\n            <input type=\"text\" placeholder=\"Search medical conditions, anatomy, pharmacology...\" required>\r\n            <button type=\"submit\" class=\"hp-search-btn\"><i class=\"fas fa-search\"><\/i><\/button>\r\n        <\/form>\r\n\r\n        <div class=\"hp-tags\">\r\n            <a href=\"#\" class=\"hp-tag\"><i class=\"fas fa-stethoscope\"><\/i> Anatomy<\/a>\r\n            <a href=\"#\" class=\"hp-tag\"><i class=\"fas fa-heartbeat\"><\/i> Physiology<\/a>\r\n            <a href=\"#\" class=\"hp-tag\"><i class=\"fas fa-dna\"><\/i> Biochemistry<\/a>\r\n            <a href=\"#\" class=\"hp-tag\"><i class=\"fas fa-brain\"><\/i> Psychiatry<\/a>\r\n            <a href=\"#\" class=\"hp-tag\"><i class=\"fas fa-user-nurse\"><\/i> Nursing<\/a>\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <!-- Features Section -->\r\n    <div class=\"hp-cta-section\" style=\"padding-bottom: 20px;\">\r\n        <h2>Everything You Need to <span class=\"hp-text-purple\">Succeed<\/span><\/h2>\r\n        <p>Comprehensive resources designed specifically for Ugandan medical students<\/p>\r\n        \r\n        <div class=\"hp-grid-4\">\r\n            <div class=\"hp-feature-card\">\r\n                <i class=\"fas fa-book-open\"><\/i>\r\n                <h4>Class Notes<\/h4>\r\n                <p>Detailed notes covering all medical subjects from Year 1 to Finals<\/p>\r\n            <\/div>\r\n            <div class=\"hp-feature-card\">\r\n                <i class=\"fas fa-download\"><\/i>\r\n                <h4>Past Papers<\/h4>\r\n                <p>Previous exam papers with detailed solutions and marking schemes<\/p>\r\n            <\/div>\r\n            <div class=\"hp-feature-card\">\r\n                <i class=\"fas fa-users\"><\/i>\r\n                <h4>Study Groups<\/h4>\r\n                <p>Connect with fellow students and form study partnerships<\/p>\r\n            <\/div>\r\n            <div class=\"hp-feature-card\">\r\n                <i class=\"fas fa-clock\"><\/i>\r\n                <h4>24\/7 Access<\/h4>\r\n                <p>Study anytime, anywhere with our mobile-optimized platform<\/p>\r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n    <!-- Testimonials Section -->\r\n    <div class=\"hp-cta-section\">\r\n        <h2>What Medical Students Say<\/h2>\r\n        <p>Join thousands of successful students<\/p>\r\n\r\n        <div class=\"hp-grid-3\">\r\n            <div class=\"hp-test-card\">\r\n                <i class=\"fas fa-quote-left hp-quote-icon\"><\/i>\r\n                <p class=\"hp-test-text\">\"This platform helped me pass my final exams with distinction. The notes are comprehensive and perfectly aligned with our curriculum.\"<\/p>\r\n                <div class=\"hp-test-author\">\r\n                    <div class=\"hp-avatar\">SA<\/div>\r\n                    <div class=\"hp-author-info\">\r\n                        <h5>Sarah Akello<\/h5>\r\n                        <span>Final Year, Makerere University<\/span>\r\n                    <\/div>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <div class=\"hp-test-card\">\r\n    