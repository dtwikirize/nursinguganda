x-sizing: border-box; \/* Important for padding calculations *\/\r\n            border-top: 1px solid #ccc;\r\n            border-bottom: 1px solid #ccc;\r\n        }\r\n        .checklist-header { text-align: center; margin-bottom: 25px; }\r\n        .checklist-header h1 { font-size: 1em; font-weight: bold; margin: 2px 0; }\r\n        .checklist-header .checklist-title { text-decoration: underline; font-weight: bold; font-size: 0.9em; }\r\n        .info-section { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 20px; font-size: 0.9em; }\r\n        .info-field { display: flex; width: 48%; min-width: 250px; margin-bottom: 10px; }\r\n        .info-field label { font-weight: bold; white-space: nowrap; margin-right: 8px; }\r\n        .info-field .line { border-bottom: 1px solid #000; width: 100%; }\r\n        .table-scroll-wrapper { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }\r\n        .checklist-table { width: 100%; min-width: 750px; border-collapse: collapse; font-size: 0.9em; }\r\n        .checklist-table th, .checklist-table td { border: 1px solid #000; padding: 8px; text-align: left; vertical-align: middle; }\r\n        .checklist-table thead th { font-weight: bold; text-align: center; background-color: #f3f3f3; }\r\n        .checklist-table .col-num { text-align: center; width: 5%; }\r\n        .checklist-table .col-score { text-align: center; width: 8%; }\r\n        .checklist-table .col-status { text-align: center; width: 10%; }\r\n        .checklist-table .col-key-areas { width: 57%; }\r\n        .checklist-table .sub-items { list-style-type: none; padding-left: 15px; margin: 5px 0 0 0; }\r\n        .checklist-table .sub-items li { padding: 5px 0; }\r\n        .checklist-table tfoot td { font-weight: bold; }\r\n        .comments-section { margin-top: 25px; display: flex; font-size: 0.9em; }\r\n        .comments-section label { font-weight: bold; white-space: nowrap; margin-right: 8px; }\r\n        .comments-section .line { border-bottom: 1.5px dotted #000; width: 100%; }\r\n        .footer-logo { margin-top: 30px; font-size: 0.9em; }\r\n        \r\n        @media (min-width: 768px) {\r\n            .toc-list {\r\n                column-count: 2;\r\n            }\r\n        }\r\n        @media (min-width: 1024px) {\r\n            .toc-list {\r\n                column-count: 3; \/* 3 columns on wide screens *\/\r\n            }\r\n        }\r\n    <\/style>\r\n<\/head>\r\n<body>\r\n\r\n<div class=\"page-container\">\r\n\r\n    <!-- =========== TABLE OF CONTENTS =========== -->\r\n    <div class=\"toc-wrapper\">\r\n        <h2>Diploma in Nursing (Extension) - Year 1: Semester 1 Checklists<\/h2>\r\n        <ul class=\"toc-list\">\r\n            <li><a href=\"#lifting-s1\">Lifting a Patient with Spinal Injury<\/a><\/li>\r\n            <li><a href=\"#uwds\">Changing the Bottle in Under Water Seal Drainage<\/a><\/li>\r\n            <li><a href=\"#ear-syringing\">Ear Syringing<\/a><\/li>\r\n            <li><a href=\"#mental-status\">Mental Status Examination<\/a><\/li>\r\n        <\/ul>\r\n    <\/div>\r\n<script async src=\"https:\/\/pagead2.googlesyndication.com\/pagead\/js\/adsbygoogle.js?client=ca-pub-5767364969818632\"\r\n     crossorigin=\"anonymous\"><\/script>\r\n<ins class=\"adsbygoogle\"\r\n     style=\"display:block; text-align:center;\"\r\n     data-ad-layout=\"in-article\"\r\n     data-ad-format=\"fluid\"\r\n     data-ad-client=\"ca-pub-5767364969818632\"\r\n     data-ad-slot=\"6261327459\"><\/ins>\r\n<script>\r\n     (adsbygoogle = window.adsbygoogle || []).push({});\r\n<\/script>\r\n    <!-- =========== CHECKLIST 1: LIFTING A PATIENT WITH SPINAL INJURY =========== -->\r\n    <div class=\"checklist-container\" id=\"lifting-s1\">\r\n        <header class=\"checklist-header\">\r\n            <h1>UGANDA NURSES AND MIDWIVES EXAMINATIONS BOARD<\/h1>\r\n            <h1>YEAR 1: SEMESTER 1: EXAMINATIONS<\/h1>\r\n            <h1>DIPLOMA IN NURSING (EXTENSION)<\/h1>\r\n            <h1>Paper code: DNE 115 OSPE<\/h1>\r\n            <h1>June 2024<\/h1>\r\n            <p class=\"checklist-title\">Examiners' Checklist<\/p>\r\n        <\/header>\r\n        <section class=\"info-section\">\r\n            <div class=\"info-field\"><label>STATION NO: 3<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>TASK: LIFTING A PATIENT WITH SPINAL INJURY FROM STRETCHER TO BED<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>Examiner's Name:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Date:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>School code:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Candidate's No:<\/label><div class=\"line\"><\/div><\/div>\r\n        <\/section>\r\n        <div class=\"table-scroll-wrapper\">\r\n            <table class=\"checklist-table\">\r\n                <thead><tr><th class=\"col-num\"><\/th><th class=\"col-key-areas\">Key areas to assess<\/th><th class=\"col-score\">Score<\/th><th class=\"col-status\">Done<\/th><th class=\"col-status\">Partially done<\/th><th class=\"col-status\">Not done<\/th><\/tr><\/thead>\r\n                <tbody>\r\n                    <tr><td class=\"col-num\">1<\/td><td class=\"col-key-areas\">Explains the procedure to the patient<\/td><td class=\"col-score\">\u00bd<\/td><td><\/td><td>x<\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">2<\/td><td class=\"col-key-areas\">Requests for 2 assistants and instructs them on what to do at each step<\/td><td class=\"col-score\">1<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">3<\/td><td class=\"col-key-areas\">Washes hands and dries them<\/td><td class=\"col-score\">\u00bd<\/td><td><\/td><td>x<\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">4<\/td><td class=\"col-key-areas\">Positions the stretcher in an ideal situ for easy turning<\/td><td class=\"col-score\">\u00bd<\/td><td><\/td><td>x<\/td><td><\/td><\/tr>\r\n                    <tr>\r\n                        <td class=\"col-num\">5<\/td>\r\n                        <td class=\"col-key-areas\">Together, the 3 nurses take position;<ul class=\"sub-items\"><li>\u2022 One nurse supports the patient's upper body, shoulder and chest area<\/li><li>\u2022 The second nurse supports the chest area and abdominal area<\/li><li>\u2022 The 3<sup>rd<\/sup> nurse supports the legs<\/li><\/ul><\/td>\r\n                        <td class=\"col-score\"><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>1<\/li><li>1<\/li><li>1<\/li><\/ul><\/td>\r\n                        <td><\/td><td><\/td><td><\/td>\r\n                    <\/tr>\r\n                    <tr><td class=\"col-num\">6<\/td><td class=\"col-key-areas\">On completion of placing hands at the right places of support, all the 3 nurses count 3 times and lift the patient systematically to the bed.<\/td><td class=\"col-score\">3<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">7<\/td><td class=\"col-key-areas\">Places patient comfortably on the bed<\/td><td class=\"col-score\">1<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">8<\/td><td class=\"col-key-areas\">Leaves patient comfortable and washes hands<\/td><td class=\"col-score\">\u00bd<\/td><td><\/td><td>x<\/td><td><\/td><\/tr>\r\n                <\/tbody>\r\n                <tfoot><tr><td colspan=\"2\">TOTAL<\/td><td class=\"col-score\">10<\/td><td><\/td><td><\/td><td><\/td><\/tr><\/tfoot>\r\n            <\/table>\r\n        <\/div>\r\n        <section class=\"comments-section\"><label>Examiner's Comments<\/label><div class=\"line\"><\/div><\/section>\r\n        <footer class=\"footer-logo\">@unmeb<\/footer>\r\n    <\/div>\r\n<script async src=\"https:\/\/pagead2.googlesyndication.com\/pagead\/js\/adsbygoogle.js?client=ca-pub-5767364969818632\"\r\n     crossorigin=\"anonymous\"><\/script>\r\n<ins class=\"adsbygoogle\"\r\n     style=\"display:block; text-align:center;\"\r\n     data-ad-layout=\"in-article\"\r\n     data-ad-format=\"fluid\"\r\n     data-ad-client=\"ca-pub-5767364969818632\"\r\n     data-ad-slot=\"6261327459\"><\/ins>\r\n<script>\r\n     (adsbygoogle = window.adsbygoogle || []).push({});\r\n<\/script>\r\n    <!-- =========== CHECKLIST 2: CHANGING BOTTLE IN UWSD =========== -->\r\n    <div class=\"checklist-container\" id=\"uwds\">\r\n        <header class=\"checklist-header\">\r\n            <h1>UGANDA NURSES AND MIDWIVES EXAMINATIONS BOARD<\/h1>\r\n            <h1>YEAR 1: SEMESTER 1: EXAMINATIONS<\/h1>\r\n            <h1>DIPLOMA IN NURSING (EXTENSION)<\/h1>\r\n            <h1>Paper code: DNE 115 OSPE<\/h1>\r\n            <h1>June 2024<\/h1>\r\n            <p class=\"checklist-title\">Examiners' Checklist<\/p>\r\n        <\/header>\r\n        <section class=\"info-section\">\r\n            <div class=\"info-field\"><label>STATION NO: 4<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>TASK: CHANGING THE BOTTLE IN UNDER WATER SEAL DRAINAGE<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>Examiner's Name:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Date:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>School code:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Candidate's No:<\/label><div class=\"line\"><\/div><\/div>\r\n        <\/section>\r\n        <div class=\"table-scroll-wrapper\">\r\n            <table class=\"checklist-table\">\r\n                <thead><tr><th class=\"col-num\"><\/th><th class=\"col-key-areas\">Key areas to assess<\/th><th class=\"col-score\">Score<\/th><th class=\"col-status\">Done<\/th><th class=\"col-status\">Partially done<\/th><th class=\"col-status\">Not done<\/th><\/tr><\/thead>\r\n                <tbody>\r\n                    <tr><td class=\"col-num\">1<\/td><td class=\"col-key-areas\">Creates rapport with patient<\/td><td class=\"col-score\">\u00bd<\/td><td><\/td><td>x<\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">2<\/td><td class=\"col-key-areas\">Washes hands and puts on gloves<\/td><td class=\"col-score\">\u00bd<\/td><td><\/td><td>x<\/td><td><\/td><\/tr>\r\n                    <tr>\r\n                        <td class=\"col-num\">3<\/td>\r\n                        <td class=\"col-key-areas\">Changes the bottle;<ul class=\"sub-items\"><li>\u2022 Securely clumps off the drain with two clamps<\/li><li>\u2022 Disconnects the tubing and puts used apparatus aside<\/li><li>\u2022 Connects new tubing and bottle<\/li><li>\u2022 Removes clamps<\/li><\/ul><\/td>\r\n                        <td class=\"col-score\"><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>1<\/li><li>1<\/li><li>1<\/li><li>1<\/li><\/ul><\/td>\r\n                        <td><\/td><td><\/td><td><\/td>\r\n                    <\/tr>\r\n                    <tr>\r\n                        <td class=\"col-num\">4<\/td>\r\n                        <td class=\"col-key-areas\">Confirms integrity of the UWSD system is intact;<ul class=\"sub-items\"><li>\u2022 Ensures all connections are secure with no leakage<\/li><li>\u2022 Checks to see that the patient is not compressing or kicking any part to avoid obstruction<\/li><li>\u2022 Maintains the bottle below the level of the patient's chest, in a stand<\/li><\/ul><\/td>\r\n                        <td class=\"col-score\"><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>1<\/li><li>1<\/li><li>1<\/li><\/ul><\/td>\r\n                        <td><\/td><td><\/td><td><\/td>\r\n                    <\/tr>\r\n                    <tr><td class=\"col-num\">5<\/td><td class=\"col-key-areas\">Monitors the fluid in tubing to confirm it is moving in rhythm with patients' respiration rate<\/td><td class=\"col-score\">1<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">6<\/td><td class=\"col-key-areas\">Record amount of drainage on the fluid balance chart, noting any abnormalities<\/td><td class=\"col-score\">1<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">7<\/td><td class=\"col-key-areas\">Washes hands and clears away<\/td><td class=\"col-score\">-<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                <\/tbody>\r\n                <tfoot><tr><td colspan=\"2\">TOTAL<\/td><td class=\"col-score\">10<\/td><td><\/td><td><\/td><td><\/td><\/tr><\/tfoot>\r\n            <\/table>\r\n        <\/div>\r\n        <section class=\"comments-section\"><label>Examiner's Comments<\/label><div class=\"line\"><\/div><\/section>\r\n        <footer class=\"footer-logo\">@unmeb<\/footer>\r\n    <\/div>\r\n<script async src=\"https:\/\/pagead2.googlesyndication.com\/pagead\/js\/adsbygoogle.js?client=ca-pub-5767364969818632\"\r\n     crossorigin=\"anonymous\"><\/script>\r\n<ins class=\"adsbygoogle\"\r\n     style=\"display:block; text-align:center;\"\r\n     data-ad-layout=\"in-article\"\r\n     data-ad-format=\"fluid\"\r\n     data-ad-client=\"ca-pub-5767364969818632\"\r\n     data-ad-slot=\"6261327459\"><\/ins>\r\n<script>\r\n     (adsbygoogle = window.adsbygoogle || []).push({});\r\n<\/script>\r\n    <!-- =========== CHECKLIST 3: EAR SYRINGING =========== -->\r\n    <div class=\"checklist-container\" id=\"ear-syringing\">\r\n        <header class=\"checklist-header\">\r\n            <h1>UGANDA NURSES AND MIDWIVES EXAMINATIONS BOARD<\/h1>\r\n            <h1>YEAR 1: SEMESTER 1: EXAMINATIONS<\/h1>\r\n            <h1>DIPLOMA IN NURSING (EXTENSION)<\/h1>\r\n            <h1>Paper code: DNE 115 OSPE<\/h1>\r\n            <h1>June 2024<\/h1>\r\n            <p class=\"checklist-title\">Examiners' Checklist<\/p>\r\n        <\/header>\r\n        <section class=\"info-section\">\r\n            <div class=\"info-field\"><label>STATION NO: 1<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>TASK: EAR SYRINGING<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>Examiner's Name:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Date:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>School code:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Candidate's No:<\/label><div class=\"line\"><\/div><\/div>\r\n        <\/section>\r\n        <div class=\"table-scroll-wrapper\">\r\n            <table class=\"checklist-table\">\r\n                <thead><tr><th class=\"col-num\">S\/N<\/th><th class=\"col-key-areas\">Key areas to assess<\/th><th class=\"col-score\">Score<\/th><th class=\"col-status\">Done<\/th><th class=\"col-status\">Partially done<\/th><th class=\"col-status\">Not done<\/th><\/tr><\/thead>\r\n                <tbody>\r\n                    <tr><td class=\"col-num\">1<\/td><td class=\"col-key-areas\">Creates nurse-patient relationship<\/td><td class=\"col-score\">-<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr><td class=\"col-num\">2<\/td><td class=\"col-key-areas\">Inspects the auditory canal using autoscope under good light<\/td><td class=\"col-score\">\u00bd<\/td><td><\/td><td>x<\/td><td><\/td><\/tr>\r\n                    <tr>\r\n                        <td class=\"col-num\">3<\/td>\r\n                        <td class=\"col-key-areas\">Prepares the patient;<ul class=\"sub-items\"><li>\u2022 Requests the patient to sit and tilt the head slightly toward the affected ear<\/li><li>\u2022 Places mackintosh and towel over the shoulder and upper arm, under the affected ear<\/li><li>\u2022 Places the curved part of the receiver below the tilted ear<\/li><li>\u2022 Requests patient to support the receiver under the ear<\/li><\/ul><\/td>\r\n                        <td class=\"col-score\"><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>\u00bd<\/li><li>\u00bd<\/li><li>\u00bd<\/li><li>\u00bd<\/li><\/ul><\/td>\r\n                        <td><\/td><td><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>x<\/li><li>x<\/li><li>x<\/li><li>x<\/li><\/ul><\/td><td><\/td>\r\n                    <\/tr>\r\n                    <tr><td class=\"col-num\">4<\/td><td class=\"col-key-areas\">Cleans auricle and meatus of auditory canal with moistened swabs<\/td><td class=\"col-score\">1<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr>\r\n                        <td class=\"col-num\">5<\/td>\r\n                        <td class=\"col-key-areas\">Irrigates the ear;<ul class=\"sub-items\"><li>\u2022 Fills bulb with irrigating solution<\/li><li>\u2022 Straightens the auditory canal by pulling the auricle up and back<\/li><li>\u2022 Inserts the tip of the syringe gently. Directs a steady slow stream of solution onto the auditory canal roof using enough force to remove insect<\/li><li>\u2022 Observe patient throughout syringing<\/li><li>\u2022 When irrigation is complete, places a cotton ball loosely in auditory meatus and requests patient to lie on the affected ear on a towel or absorbent pad<\/li><li>\u2022 Dries the patient's auricle and removes the patient's towel and mackintosh cape<\/li><\/ul><\/td>\r\n                        <td class=\"col-score\"><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>\u00bd<\/li><li>\u00bd<\/li><li>2<\/li><li>\u00bd<\/li><li>2<\/li><li>1<\/li><\/ul><\/td>\r\n                        <td><\/td><td><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>x<\/li><li>x<\/li><li><\/li><li>x<\/li><\/ul><\/td><td><\/td>\r\n                    <\/tr>\r\n                    <tr><td class=\"col-num\">6<\/td><td class=\"col-key-areas\">Clears away<\/td><td class=\"col-score\">-<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                <\/tbody>\r\n                <tfoot><tr><td colspan=\"2\">TOTAL<\/td><td class=\"col-score\">10<\/td><td><\/td><td><\/td><td><\/td><\/tr><\/tfoot>\r\n            <\/table>\r\n        <\/div>\r\n        <section class=\"comments-section\"><label>Examiner's Comments<\/label><div class=\"line\"><\/div><\/section>\r\n        <footer class=\"footer-logo\">@unmeb<\/footer>\r\n    <\/div>\r\n<script async src=\"https:\/\/pagead2.googlesyndication.com\/pagead\/js\/adsbygoogle.js?client=ca-pub-5767364969818632\"\r\n     crossorigin=\"anonymous\"><\/script>\r\n<!-- Display Ad Posts -->\r\n<ins class=\"adsbygoogle\"\r\n     style=\"display:block\"\r\n     data-ad-client=\"ca-pub-5767364969818632\"\r\n     data-ad-slot=\"7570414357\"\r\n     data-ad-format=\"auto\"\r\n     data-full-width-responsive=\"true\"><\/ins>\r\n<script>\r\n     (adsbygoogle = window.adsbygoogle || []).push({});\r\n<\/script>\r\n    <!-- =========== CHECKLIST 4: MENTAL STATUS EXAMINATION =========== -->\r\n    <div class=\"checklist-container\" id=\"mental-status\">\r\n        <header class=\"checklist-header\">\r\n            <h1>UGANDA NURSES AND MIDWIVES EXAMINATIONS BOARD<\/h1>\r\n            <h1>YEAR 1: SEMESTER 1: EXAMINATIONS<\/h1>\r\n            <h1>DIPLOMA IN NURSING (EXTENSION)<\/h1>\r\n            <h1>Paper code: DNE 115 OSPE<\/h1>\r\n            <h1>June 2024<\/h1>\r\n            <p class=\"checklist-title\">Examiners' Checklist<\/p>\r\n        <\/header>\r\n        <section class=\"info-section\">\r\n            <div class=\"info-field\"><label>STATION NO: 2<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>TASK: MENTAL STATUS EXAMINATION<\/label><\/div><div class=\"info-field\"><\/div>\r\n            <div class=\"info-field\"><label>Examiner's Name:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Date:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>School code:<\/label><div class=\"line\"><\/div><\/div>\r\n            <div class=\"info-field\"><label>Candidate's No:<\/label><div class=\"line\"><\/div><\/div>\r\n        <\/section>\r\n        <div class=\"table-scroll-wrapper\">\r\n            <table class=\"checklist-table\">\r\n                <thead><tr><th class=\"col-num\">No.<\/th><th class=\"col-key-areas\">Key areas to assess<\/th><th class=\"col-score\">Score<\/th><th class=\"col-status\">Done<\/th><th class=\"col-status\">Partially done<\/th><th class=\"col-status\">Not done<\/th><\/tr><\/thead>\r\n                <tbody>\r\n                    <tr><td class=\"col-num\">1<\/td><td class=\"col-key-areas\">Explains procedure to the patient<\/td><td class=\"col-score\">1<\/td><td><\/td><td><\/td><td><\/td><\/tr>\r\n                    <tr>\r\n                        <td class=\"col-num\">2<\/td>\r\n                        <td class=\"col-key-areas\">Examines the following;<ul class=\"sub-items\"><li>\u2022 Appearance and behavior (dress, hygiene, posture, appearance and response to actions)<\/li><li>\u2022 Orientation and level of awareness<\/li><li>\u2022 Thought processes (what patient is thinking and process used in his\/her thinking)<\/li><li>\u2022 Memory (short and long term)<\/li><li>\u2022 Speech and ability to communicate<\/li><li>\u2022 Mood and affect (patient's feelings and emotions and outward expression)<\/li><li>\u2022 Judgment<\/li><li>\u2022 Perception (experiences of reality)<\/li><\/ul><\/td>\r\n                        <td class=\"col-score\"><ul class=\"sub-items\" style=\"text-align: center; padding:0;\"><li>1<\/li><li>1<\/li><li>1<\/li><li>1<\/li><li>1<\/li><li>2<\/li><li>1<\/li><li>1<\/li><\/ul><\/td>\r\n                        <td><\/td><td><\/td><td><\/td>\r\n                    <\/tr>\r\n                <\/tbody>\r\n     