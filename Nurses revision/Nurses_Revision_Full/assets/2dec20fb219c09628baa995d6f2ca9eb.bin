		<item>
		<title>Skin and Soft Tissue Infections (SSTIs)</title>
		<link>https://nursesrevisionuganda.com/skin-and-soft-tissue-infections-sstis/</link>
					<comments>https://nursesrevisionuganda.com/skin-and-soft-tissue-infections-sstis/#respond</comments>
		
		<dc:creator><![CDATA[nursesrevision@gmail.com]]></dc:creator>
		<pubDate>Sun, 19 Apr 2026 05:32:56 +0000</pubDate>
