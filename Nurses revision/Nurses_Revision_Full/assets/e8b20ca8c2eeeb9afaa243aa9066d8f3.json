round: #dcfce7; color: #059669; }\r\n    .badge-orange { background: #ffedd5; color: #ea580c; }\r\n    .badge-pink { background: #fce7f3; color: #db2777; }\r\n\r\n    .unit-card-header h3 {\r\n        margin: 0;\r\n        font-size: 1.4rem;\r\n        font-weight: 800;\r\n        color: #111827;\r\n        line-height: 1.3;\r\n    }\r\n\r\n    .unit-sub-section {\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .unit-list {\r\n        list-style-type: disc;\r\n        padding-left: 25px;\r\n        margin: 0;\r\n    }\r\n\r\n    .unit-list li {\r\n        margin-bottom: 8px;\r\n        color: #111827;\r\n    }\r\n\r\n    .unit-list a {\r\n        color: #3b82f6;\r\n        text-decoration: none;\r\n        font-size: 0.95rem;\r\n        font-weight: 500;\r\n        transition: color 0.2s ease, text-decoration 0.2s ease;\r\n    }\r\n\r\n    .unit-list a:hover {\r\n        color: #9333ea;\r\n        text-decoration: underline;\r\n    }\r\n\r\n    .unit-references-section {\r\n        max-width: 800px;\r\n        margin: 60px auto;\r\n        text-align: center;\r\n        padding: 0 20px 60px;\r\n    }\r\n\r\n    .unit-references-section h2 {\r\n        font-size: 2rem;\r\n        font-weight: 800;\r\n        color: #111827;\r\n        margin: 0 0 10px 0;\r\n    }\r\n\r\n    .unit-references-section p {\r\n        color: #4b5563;\r\n        margin: 0 0 30px 0;\r\n    }\r\n\r\n    .unit-references-list {\r\n        text-align: left;\r\n        font-size: 0.9rem;\r\n        color: #6b7280;\r\n        line-height: 1.8;\r\n        padding-left: 20px;\r\n    }\r\n\r\n    .unit-references-list li { margin-bottom: 10px; }\r\n    .unit-references-list strong { color: #111827; font-weight: 600; }\r\n\r\n    @media (max-width: 768px) {\r\n        .unit-hero h1 { font-size: 2.2rem; }\r\n        .unit-card { padding: 20px; }\r\n        .unit-card-header { gap: 15px; margin-bottom: 20px; }\r\n        .unit-card-header h3 { font-size: 1.2rem; }\r\n    }\r\n<\/style>\r\n\r\n<div class=\"curriculum-page-wrapper\">\r\n    <div class=\"unit-hero\">\r\n        <h1>BNS 116: <span class=\"unit-highlight\">Nursing Informatics<\/span><\/h1>\r\n        <p>An introduction to the use of information and technology in healthcare, focusing on electronic health records, telehealth, and the ethical considerations for nurses.<\/p>\r\n    <\/div>\r\n\r\n    <div class=\"unit-content-section\">\r\n        <h2>Course Content<\/h2>\r\n        <p>Explore the detailed topics covered in Nursing Informatics.<\/p>\r\n\r\n        <div class=\"unit-container\">\r\n\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-purple\"><i class=\"fas fa-laptop-medical\"><\/i><\/div>\r\n                    <h3>Introduction to Nursing Informatics<\/h3>\r\n                <\/div>\r\n                <div class=\"unit-sub-section\">\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Definition and Scope<\/a><\/li>\r\n                        <li><a href=\"#\">Impact of Technology on Health Care<\/a><\/li>\r\n                        <li><a href=\"#\">Theoretical Models (includes DIKW)<\/a><\/li>\r\n                        <li><a href=\"#\">Documentation & Nursing Language<\/a><\/li>\r\n                        <li><a href=\"#\">Communication & Counselling<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-blue\"><i class=\"fas fa-server\"><\/i><\/div>\r\n                    <h3>Health Information Systems (HIS)<\/h3>\r\n                <\/div>\r\n                <div class=\"unit-sub-section\">\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">EHR vs. EMR vs. Paper Records<\/a><\/li>\r\n                        <li><a href=\"#\">Components of EHRs<\/a><\/li>\r\n                        <li><a href=\"#\">Clinical Decision Support Systems (CDSS)<\/a><\/li>\r\n                        <li><a href=\"#\">Computerized Physician Order Entry (CPOE)<\/a><\/li>\r\n                        <li><a href=\"#\">Interoperability & Standards<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-green\"><i class=\"fas fa-house-medical-circle-check\"><\/i><\/div>\r\n                    <h3>Telehealth and Telenursing<\/h3>\r\n                <\/div>\r\n                <div class=\"unit-sub-section\">\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Definitions<\/a><\/li>\r\n                        <li><a href=\"#\">Applications in Nursing Practice<\/a><\/li>\r\n                        <li><a href=\"#\">Benefits and Challenges<\/a><\/li>\r\n                        <li><a href=\"#\">Technologies Used<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-orange\"><i class=\"fas fa-scale-unbalanced\"><\/i><\/div>\r\n                    <h3>Ethical, Legal, and Social Issues<\/h3>\r\n                <\/div>\r\n                <div class=\"unit-sub-section\">\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Privacy & Confidentiality<\/a><\/li>\r\n                        <li><a href=\"#\">Data Security & Protection (HIPAA)<\/a><\/li>\r\n                        <li><a href=\"#\">Data Integrity & Accuracy<\/a><\/li>\r\n                        <li><a href=\"#\">The Digital Divide<\/a><\/li>\r\n                        <li><a href=\"#\">Legal Aspects of Health IT<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-blue\"><i class=\"fas fa-list-check\"><\/i><\/div>\r\n                    <h3>Informatics Competencies for Nurses<\/h3>\r\n                <\/div>\r\n                <div class=\"unit-sub-section\">\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Basic Computer Literacy<\/a><\/li>\r\n                        <li><a href=\"#\">Information Literacy<\/a><\/li>\r\n                        <li><a href=\"#\">Proficient Use of HIS\/EHR<\/a><\/li>\r\n                        <li><a href=\"#\">Understanding Data Standards<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n            <div class=\"unit-card\">\r\n                <div class=\"unit-card-header\">\r\n                    <div class=\"unit-icon-box badge-pink\"><i class=\"fas fa-chart-line\"><\/i><\/div>\r\n                    <h3>Future Trends in Nursing Informatics<\/h3>\r\n                <\/div>\r\n                <div class=\"unit-sub-section\">\r\n                    <ul class=\"unit-list\">\r\n                        <li><a href=\"#\">Artificial Intelligence (AI) & Machine Learning<\/a><\/li>\r\n                        <li><a href=\"#\">Big Data Analytics<\/a><\/li>\r\n                        <li><a href=\"#\">Mobile Health (mHealth)<\/a><\/li>\r\n                        <li><a href=\"#\">Genomics & Personalized Medicine<\/a><\/li>\r\n                    <\/ul>\r\n                <\/div>\r\n            <\/div>\r\n\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <div class=\"unit-references-section\">\r\n        <h2>Key References<\/h2>\r\n        <p>A selection of key texts and resources cited in this course unit.<\/p>\r\n        <ol class=\"unit-references-list\">\r\n        