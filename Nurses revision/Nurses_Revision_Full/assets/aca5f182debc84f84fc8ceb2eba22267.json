{"id":25226,"date":"2025-06-20T07:27:07","date_gmt":"2025-06-20T07:27:07","guid":{"rendered":"https:\/\/nursesrevisionuganda.com\/?page_id=25226"},"modified":"2025-06-21T07:24:10","modified_gmt":"2025-06-21T07:24:10","slug":"submit-your-research","status":"publish","type":"page","link":"https:\/\/nursesrevisionuganda.com\/submit-your-research\/","title":{"rendered":"Submit Your Research"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"25226\" class=\"elementor elementor-25226\" data-elementor-settings=\"{&quot;ha_cmc_init_switcher&quot;:&quot;no&quot;}\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-3429d85 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"3429d85\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;_ha_eqh_enable&quot;:false}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-02b98ea\" data-id=\"02b98ea\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-dccf0bb elementor-widget elementor-widget-html\" data-id=\"dccf0bb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n    \/* Basic Resets & Astra Integration (assuming Astra handles global fonts\/colors) *\/\r\n    .page-id-YOUR_PAGE_ID .site-content {\r\n        padding: 0; \/* Remove theme padding if needed *\/\r\n    }\r\n\r\n    .submit-research-body {\r\n        font-family: 'Montserrat', sans-serif;\r\n        line-height: 1.6;\r\n        color: #333;\r\n        background: linear-gradient(135deg, #f0f0f0, #e0f0f0);\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .submit-research-container {\r\n        max-width: 1200px;\r\n        margin: 0 auto;\r\n        padding: 20px;\r\n    }\r\n\r\n    \/* Colors from your design *\/\r\n    :root {\r\n        --primary-purple: #6a0dad;\r\n        --light-purple: #9370db;\r\n        --accent-gradient-start: #be93f8;\r\n        --accent-gradient-end: #8b5cf6;\r\n        --white: #ffffff;\r\n        --black: #000000;\r\n        --text-dark: #333333;\r\n        --text-light: #f4f4f4;\r\n    }\r\n\r\n    \/* === IMPROVED HERO SECTION === *\/\r\n    .submit-research-hero {\r\n        background: linear-gradient(45deg, var(--primary-purple), var(--light-purple));\r\n        padding: 60px 20px; \/* Reduced padding for better balance *\/\r\n        text-align: center;\r\n        position: relative;\r\n        overflow: hidden;\r\n    }\r\n\r\n    .submit-research-hero h1 {\r\n        color: var(--white); \/* Ensures text is white *\/\r\n        font-size: 2.8em; \/* Slightly smaller on desktop *\/\r\n        line-height: 1.3;\r\n        margin-bottom: 0; \/* Removed bottom margin *\/\r\n        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35); \/* Softer, more professional shadow *\/\r\n    }\r\n    \r\n    \/* --- Styles for the Pop-up Modal (No Changes Here) --- *\/\r\n    .submission-modal { display: none; position: fixed; z-index: 99999; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); }\r\n    .submission-modal-content { background-color: #fefefe; margin: 5% auto; padding: 40px; border-radius: 12px; width: 90%; max-width: 700px; position: relative; box-shadow: 0 8px 30px rgba(0,0,0,0.2); }\r\n    .close-modal-btn { color: #aaa; position: absolute; top: 10px; right: 25px; font-size: 35px; font-weight: bold; cursor: pointer; }\r\n    .close-modal-btn:hover, .close-modal-btn:focus { color: black; }\r\n\r\n\r\n    \/* --- Other styles for your page (No Changes Here) --- *\/\r\n    .glass-card { background: rgba(255, 255, 255, 0.15); border-radius: 16px; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.3); padding: 30px; margin-bottom: 30px; transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out; }\r\n    .glass-card:hover { transform: translateY(-5px); box-shadow: 0 8px 40px rgba(0, 0, 0, 0.2); }\r\n    .submit-research-content { padding: 40px 0; }\r\n    .submit-research-content h2 { color: var(--primary-purple); font-size: 2.2em; margin-bottom: 25px; text-align: center; position: relative; padding-bottom: 10px; }\r\n    .submit-research-content h2::after { content: ''; position: absolute; left: 50%; transform: translateX(-50%); bottom: 0; width: 60px; height: 4px; background: linear-gradient(to right, var(--light-purple), var(--primary-purple)); border-radius: 2px; }\r\n    .submit-research-content ul, .submit-research-content ol { list-style-position: outside; padding-left: 20px; margin-left: 0; }\r\n    .submit-research-content li { margin-bottom: 15px; font-size: 1.1em; }\r\n    .highlight { font-weight: 700; color: var(--primary-purple); background: linear-gradient(45deg, var(--accent-gradient-start), var(--accent-gradient-end)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; text-fill-color: transparent; display: inline-block; }\r\n    .submit-research-button { display: inline-block; background: linear-gradient(45deg, var(--accent-gradient-start), var(--accent-gradient-end)); color: var(--white) !important; padding: 15px 30px; border-radius: 30px; text-decoration: none; font-weight: 700; font-size: 1.1em; margin-top: 30px; transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2); border: none; cursor: pointer; }\r\n    .submit-research-button:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); }\r\n    .call-to-action { text-align: center; margin-top: 50px; padding: 40px; background: var(--white); border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }\r\n    .call-to-action p { font-size: 1.1em; color: var(--text-dark); margin-bottom: 20px; }\r\n\r\n\r\n    \/* === RESPONSIVE FIX FOR MOBILE === *\/\r\n    @media (max-width: 768px) {\r\n        .submit-research-hero {\r\n            padding: 50px 20px; \/* Further reduced padding on mobile *\/\r\n        }\r\n        .submit-research-hero h1 {\r\n            font-size: 2em; \/* Significantly smaller font size for phones *\/\r\n            line-height: 1.2;\r\n        }\r\n        .submit-research-content h2 {\r\n            font-size: 1.8em;\r\n        }\r\n        .glass-card {\r\n            padding: 20px;\r\n        }\r\n        .submit-research-button {\r\n            padding: 12px 25px;\r\n            font-size: 1em;\r\n        }\r\n    }\r\n<\/style>\r\n\r\n<div class=\"submit-research-body\">\r\n    <header class=\"submit-research-hero\">\r\n        <div class=\"submit-research-container\">\r\n            <h1>Submit Your Research: Share Your Discoveries with the World!<\/h1>\r\n        <\/div>\r\n    <\/header>\r\n    <section class=\"call-to-action\">\r\n        <p>Are you a nursing researcher with groundbreaking findings to share? Do you want your work to reach a wider audience and make a real impact? We invite you to publish your research with us!<\/p>\r\n        <p><strong><em>Research that scored GPA of 4 and above will be considered.<\/em><\/strong><\/p>\r\n    <\/section>\r\n    <main class=\"submit-research-container submit-research-content\">\r\n        <section class=\"benefits-section glass-card\">\r\n            <h2>Why Publish With Us?<\/h2>\r\n            <ul>\r\n                <li><strong>Global Reach & Impact:<\/strong> Your research will be accessible to a vast international audience of scholars, students, and professionals, maximizing its impact and visibility.<\/li>\r\n                <li><strong>Rigorous Peer Review:<\/strong> We uphold the highest standards of academic integrity through a thorough and constructive peer-review process, ensuring the quality and credibility of your published work.<\/li>\r\n                <li><strong>Fair Revenue Share:<\/strong> We believe in compensating researchers fairly for their valuable contributions. You will receive <span class=\"highlight\">3000 UGX for every copy sold<\/span> of your published research!<\/li>\r\n                <li><strong>Dedicated Author Support:<\/strong> Our team is here to support you throughout the publication process, from submission to promotion.<\/li>\r\n                <li><strong>Broad Visibility:<\/strong> We ensure your research is discoverable by indexing it within our platform, increasing its reach and citation potential.<\/li>\r\n            <\/ul>\r\n        <\/section>\r\n\r\n        <section class=\"process-section glass-card\">\r\n            <h2>Our Simple Publication Process:<\/h2>\r\n            <ol>\r\n                <li><strong>Submission:<\/strong> Prepare your research manuscript according to our Submission Guidelines. Use our easy online submission portal to upload your work.<\/li>\r\n                <li><strong>Initial Review:<\/strong> Our editorial team will conduct an initial assessment to ensure your manuscript aligns with our scope and standards.<\/li>\r\n                <li><strong>Peer Review:<\/strong> Your manuscript will undergo a rigorous, double-blind peer-review process by experts in your field. This typically takes 4-6 weeks.<\/li>\r\n                <li><strong>Decision & Revision:<\/strong> Based on the reviewers' feedback, you'll receive a decision. If revisions are requested, you'll have ample time to address them.<\/li>\r\n                <li><strong>Copyediting & Production:<\/strong> Once accepted, your manuscript will be professionally copyedited and prepared for publication.<\/li>\r\n                <li><strong>Publication:<\/strong> Your research will be published and made available to our global readership!<\/li>\r\n            <\/ol>\r\n        <\/section>\r\n\r\n        <section class=\"timeline-section glass-card\">\r\n            <h2>Submission Guidelines<\/h2>\r\n            <ul>\r\n                <li><strong>File Format:<\/strong> Please submit your document in Microsoft Word (.docx) or PDF format.<\/li>\r\n                <li><strong>Formatting:<\/strong> Use a standard font like Times New Roman (12pt), double-spaced.<\/li>\r\n                <li><strong>Required Sections:<\/strong> Ensure your submission includes a Title Page, Abstract, Introduction, Methodology, Results, Discussion, and References.<\/li>\r\n            <\/ul>\r\n        <\/section>\r\n\r\n        <section class=\"revenue-section glass-card\">\r\n            <h2>Revenue Share Model:<\/h2>\r\n            <p>We believe in a transparent and rewarding revenue-sharing model. For every copy of your research sold, you will receive <span class=\"highlight\">3000 UGX!<\/span> Payments are processed monthly and can be deposited directly into your Mobile Money account.<\/p>\r\n        <\/section>\r\n\r\n        <section class=\"call-to-action\">\r\n            <p>Ready to publish your research and make a global impact?<\/p>\r\n            <!-- THIS IS THE BUTTON THAT OPENS THE POP-UP -->\r\n            <button id=\"open-submission-modal\" class=\"submit-research-button\">Submit Your Research Now!<\/button>\r\n        <\/section>\r\n\r\n        <section class=\"revenue-section glass-card\">\r\n            <h2 style=\"color: #c0392b;\">IMPORTANT NOTE<\/h2>\r\n            <p style=\"font-weight: bold; color: #555;\">All published research papers have already been submitted to UHPAB\/UNMEB and using the same author files for resubmission elsewhere may constitute plagiarism. The papers on this platform should be used for reference and learning purposes.<\/p>\r\n        <\/section>\r\n    <\/main>\r\n<\/div>\r\n\r\n\r\n<!-- THE HIDDEN POP-UP MODAL THAT CONTAINS YOUR FORM -->\r\n<div id=\"submission-modal\" class=\"submission-modal\">\r\n    <div class=\"submission-modal-content\">\r\n        <span class=\"close-modal-btn\">\u00d7<\/span>\r\n        <h2 style=\"text-align: center; color: var(--primary-purple); margin-top: 0;\">Research Submission Form<\/h2>\r\n        <p style=\"text-align: center; margin-bottom: 25px;\">Please fill out the details below to submit your paper for review.<\/p>\r\n        \r\n        <!-- YOUR WPFORMS SHORTCODE IS PLACED HERE -->\r\n        <div class=\"wpforms-container \" id=\"wpforms-25233\"><form id=\"wpforms-form-25233\" class=\"wpforms-validate wpforms-form wpforms-ajax-form\" data-formid=\"25233\" method=\"post\" enctype=\"multipart\/form-data\" action=\"\/wp-json\/wp\/v2\/pages\/25226\" data-token=\"52c4c6c49024536d6c106e061fdac2c8\" data-token-time=\"1777732361\"><noscript class=\"wpforms-error-noscript\">Please enable JavaScript in your browser to complete this form.<\/noscript><div class=\"wpforms-field-container\"><div id=\"wpforms-25233-field_1-container\" class=\"wpforms-field wpforms-field-name\" data-field-id=\"1\"><label class=\"wpforms-field-label\" for=\"wpforms-25233-field_1\">Name <span class=\"wpforms-required-label\">*<\/span><\/label><input type=\"text\" id=\"wpforms-25233-field_1\" class=\"wpforms-field-medium wpforms-field-required\" name=\"wpforms[fields][1]\" required><\/div><div id=\"wpforms-25233-field_2-container\" class=\"wpforms-field wpforms-field-email\" data-field-id=\"2\"><label class=\"wpforms-field-label\" for=\"wpforms-25233-field_2\">Email <span class=\"wpforms-required-label\">*<\/span><\/label><input type=\"email\" id=\"wpforms-25233-field_2\" class=\"wpforms-field-medium wpforms-field-required\" name=\"wpforms[fields][2]\" spellcheck=\"false\" required><\/div>\t\t<div id=\"wpforms-25233-field_5-container\"\n\t\t\tclass=\"wpforms-field 