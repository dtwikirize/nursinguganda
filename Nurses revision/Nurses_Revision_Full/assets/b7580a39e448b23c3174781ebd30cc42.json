  text-align: center;\r\n        padding: 0 20px;\r\n    }\r\n\r\n    .unit-references-section h2 {\r\n        font-size: 2rem;\r\n        font-weight: 800;\r\n        color: var(--unit-text-dark);\r\n        margin: 0 0 10px 0;\r\n    }\r\n\r\n    .unit-references-section p {\r\n        color: var(--unit-text-gray);\r\n        margin: 0 0 30px 0;\r\n    }\r\n\r\n    .unit-references-list {\r\n        text-align: left;\r\n        font-size: 0.9rem;\r\n        color: var(--unit-text-light);\r\n        line-height: 1.8;\r\n        padding-left: 20px;\r\n    }\r\n\r\n    .unit-references-list li {\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .unit-references-list strong {\r\n        color: var(--unit-text-dark);\r\n        font-weight: 600;\r\n    }\r\n\r\n    \/* Mobile Responsiveness *\/\r\n    @media (max-width: 768px) {\r\n        .unit-hero h1 { font-size: 2.2rem; }\r\n        .unit-card { padding: 20px; }\r\n        .unit-card-header { gap: 15px; margin-bottom: 20px; }\r\n        .unit-card-header h3 { font-size: 1.15rem; }\r\n    }\r\n<\/style>\r\n\r\n<!-- Hero Section -->\r\n<div class=\"unit-hero\">\r\n    <h1>BNS 111: <span class=\"unit-highlight\"> Anatomy Curriculum<\/span><\/h1>\r\n    <p>A foundational course covering the structure and function of the human body, from the cellular level to major organ systems, including genetics and embryology.<\/p>\r\n<\/div>\r\n\r\n<!-- Course Content Section -->\r\n<div class=\"unit-content-section\">\r\n    <h2>Course Content<\/h2>\r\n    <p>Explore the detailed topics covered in Anatomy & Physiology.<\/p>\r\n\r\n    <!-- Main Container -->\r\n    <div class=\"unit-container\">\r\n\r\n        <!-- Topic 1 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-purple\"><i class=\"fas fa-flask\"><\/i><\/div>\r\n                <h3>Introduction, Cell and Tissues<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"https:\/\/nursesrevisionuganda.com\/anatomy-introduction-2\/\">Introduction to Anatomy<\/a><\/li>\r\n                <li><a href=\"https:\/\/nursesrevisionuganda.com\/anatomical-positions-directional-terms-planes\/\">Anatomical Positions, Terms & Body planes<\/a><\/li>\r\n                <li><a href=\"https:\/\/nursesrevisionuganda.com\/anatomy-cell-theory\/\">Cell Theory, Structure & Function<\/a><\/li>\r\n                <li><a href=\"https:\/\/nursesrevisionuganda.com\/cell-cycle-and-disorders\/\">Cell Cycle & Disorders<\/a><\/li>\r\n                <li><a href=\"#\">Histology Introduction<\/a><\/li>\r\n                <li><a href=\"#\">Epithelial Tissue & Glands<\/a><\/li>\r\n                <li><a href=\"#\">Connective Tissue (Fibrous, Cartilage, Bone, Blood)<\/a><\/li>\r\n                <li><a href=\"#\">Muscle Tissue (Propulsion)<\/a><\/li>\r\n                <li><a href=\"#\">Nervous Tissue<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 2 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-blue\"><i class=\"fas fa-bone\"><\/i><\/div>\r\n                <h3>Body Systems I: Integumentary & Musculoskeletal<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Intro to Musculoskeletal System<\/a><\/li>\r\n                <li><a href=\"#\">Axial & Appendicular System<\/a><\/li>\r\n                <li><a href=\"#\">Muscles of Axial Skeleton (Head, Neck and Trunk)<\/a><\/li>\r\n                <li><a href=\"#\">Rib Cage & Diaphragm<\/a><\/li>\r\n                <li><a href=\"#\">Skin (Integumentary System)<\/a><\/li>\r\n                <li><a href=\"#\">Bone Structure & Disorders<\/a><\/li>\r\n                <li><a href=\"#\">Muscles of Upper Limbs<\/a><\/li>\r\n                <li><a href=\"#\">Muscles of Lower Limbs<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 3 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-blue\"><i class=\"fas fa-brain\"><\/i><\/div>\r\n                <h3>Central Nervous System<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Topography of the CNS<\/a><\/li>\r\n                <li><a href=\"#\">CNS Embryology<\/a><\/li>\r\n                <li><a href=\"#\">Brain Hemispheres<\/a><\/li>\r\n                <li><a href=\"#\">The Eye, Orbit, and Extraocular Muscles<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 4 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-green\"><i class=\"fas fa-lungs\"><\/i><\/div>\r\n                <h3>Respiratory System<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Respiratory System Anatomy<\/a><\/li>\r\n                <li><a href=\"#\">Upper Respiratory System Anatomy<\/a><\/li>\r\n                <li><a href=\"#\">Lower Respiratory System Anatomy<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 5 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-red\"><i class=\"fas fa-heart-pulse\"><\/i><\/div>\r\n                <h3>Cardiovascular System<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Cardiovascular System Anatomy<\/a><\/li>\r\n                <li><a href=\"#\">Heart & Great Vessels<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 6 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-teal\"><i class=\"fas fa-utensils\"><\/i><\/div>\r\n                <h3>Gastro Intestinal System<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Oral Cavity<\/a><\/li>\r\n                <li><a href=\"#\">Teeth, Tongue & Salivary Gland<\/a><\/li>\r\n                <li><a href=\"#\">Stomach & Intestines<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 7 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-teal\"><i class=\"fas fa-filter\"><\/i><\/div>\r\n                <h3>Hepatobiliary System<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Liver and Gallbladder<\/a><\/li>\r\n                <li><a href=\"#\">Spleen and Pancreas<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 8 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-teal\"><i class=\"fas fa-droplet\"><\/i><\/div>\r\n                <h3>Genitourinary System<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Urinary System<\/a><\/li>\r\n                <li><a href=\"#\">Male Reproductive System<\/a><\/li>\r\n                <li><a href=\"#\">Female Reproductive System<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n        <!-- Topic 9 -->\r\n        <div class=\"unit-card\">\r\n            <div class=\"unit-card-header\">\r\n                <div class=\"unit-icon-box icon-bg-orange\"><i class=\"fas fa-dna\"><\/i><\/div>\r\n                <h3>Genetics & Embryology<\/h3>\r\n            <\/div>\r\n            <ul class=\"unit-list\">\r\n                <li><a href=\"#\">Genetic Code & Chromosomes<\/a><\/li>\r\n                <li><a href=\"#\">Gene Expression & Inheritance<\/a><\/li>\r\n                <li><a href=\"#\">Reproductive Cycles & Gametogenesis<\/a><\/li>\r\n                <li><a href=\"#\">Fertilization & Implantation<\/a><\/li>\r\n                <li><a href=\"#\">Germ Disc, Gastrulation & Neurulation<\/a><\/li>\r\n                <li><a href=\"#\">Placenta & Foetal Membranes<\/a><\/li>\r\n                <li><a href=\"#\">Common Congenital Abnormalities<\/a><\/li>\r\n            <\/ul>\r\n        <\/div>\r\n\r\n    <\/div>\r\n<\/div>\r\n\r\n<!-- Key References Section -->\r\n<div class=\"unit-references-section\">\r\n    <h2>Key References<\/h2>\r\n    <p>A selection of key texts and resources cited in this course unit.<\/p>\r\n    \r\n    <ol class=\"unit-references-list\">\r\n        <li>Tortora, G.J. & Derickson N.,P. (2006) <strong>Principles of Anatomy and Physiology<\/strong>. Harper and Row<\/li>\r\n        <li>Drake, R, et al. (2007). <strong>Gray's Anatomy for Students<\/strong>. London: Churchill Publishers<\/li>\r\n        <li>Snell, S.R. (2004) <strong>Clinical Anatomy by Regions<\/strong>. Philadelphia: Lippincott Publishers<\/li>\r\n        <li>Marieb, E.N. (2004). <strong>Human Anatomy and physiology<\/strong>. London: Daryl Fox Publishers.<\/li>\r\n        <li>Young, B, et al. (2006). <strong>Wheater's Functional Histology: A Text and Colour Atlas<\/strong>. Churchill<\/li>\r\n        <li>Sadler, T.W. (2009). <strong>Langman's Medical Embryology<\/strong>. Philadelphia: Lippincott Publishers<\/li>\r\n    <\/ol>\r\n<\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-3657215 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"3657215\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;_ha_eqh_enable&quot;:false}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"e