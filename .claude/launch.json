{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nursing-uganda-express",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "nursing-uganda-root",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5503",
        "--directory",
        "D:/Projects/Nursing Uganda"
      ],
      "port": 5503
    },
    {
      "name": "nursing-uganda",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5500",
        "--directory",
        "D:/Projects/Nursing Uganda/Nursing-ug Web_app"
      ],
      "port": 5500
    },
    {
      "name": "nurses-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5501",
        "--directory",
        "D:/Projects/Nursing Uganda/Nurses revision/Nurses_Revision_Full"
      ],
      "port": 5501
    }
  ]
}
